@model SupplierFulfillmentDetailViewModel
@{
    ViewData["Title"] = "履约详情";
    var logistics = Model.Logistics;
    var nextStatuses = (ViewData["NextStatuses"] as List<(string Code, string Name)>)
        ?? new List<(string Code, string Name)>();
}

<div class="page-hero">
    <div>
        <div class="hero-greeting">订单 @Model.Order.OrderNo</div>
        <div class="hero-meta">
            <span class="text-white-50">@Model.CustomerName · @Model.Order.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
        </div>
    </div>
    <div class="hero-actions">
        <a class="btn btn-outline-light btn-sm" asp-action="Index">← 返回履约工作台</a>
        <span class="badge bg-light text-dark">@logistics.StatusName</span>
    </div>
</div>

@if (logistics.IsFallback)
{
    <div class="alert alert-warning">
        当前承运商与轨迹扩展数据来自可替换兜底 Provider，A 组正式接口接入后会自动切换。
    </div>
}

@if (logistics.HasException)
{
    <div class="alert alert-danger">
        <strong>履约异常：</strong>@logistics.ExceptionMessage
    </div>
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="content-card mb-3">
            <div class="content-card-header">
                <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg> 本供应商商品</h5>
            </div>
            <div class="content-card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light"><tr><th>商品</th><th>数量</th><th>单价</th><th>小计</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td>@item.Quantity</td>
                                <td>¥@item.UnitPrice.ToString("F2")</td>
                                <td>¥@item.SubTotal.ToString("F2")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="content-card">
            <div class="content-card-header">
                <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11z"/><circle cx="12" cy="10" r="2.6"/></svg> 收货信息</h5>
            </div>
            <div class="content-card-body">
                <p class="mb-1"><strong>@Model.Order.ReceiverName</strong> @Model.Order.ReceiverPhone</p>
                <p class="mb-0 text-muted">@Model.Order.ShippingAddress</p>
            </div>
        </div>

        @if (logistics.Events.Count > 0)
        {
            <div class="content-card mt-3">
                <div class="content-card-header">
                    <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="19" r="2"/><circle cx="18" cy="5" r="2"/><path d="M8 19h7a4 4 0 0 0 0-8H9a4 4 0 0 1 0-8h5"/></svg> 物流轨迹</h5>
                    <span class="text-muted small">共 @logistics.Events.Count 条</span>
                </div>
                <div class="content-card-body p-0">
                    <div class="list-group list-group-flush">
                        @foreach (var item in logistics.Events.OrderByDescending(item => item.OccurredAt))
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between gap-3">
                                    <strong>@item.StatusName</strong>
                                    <span class="small text-muted">@item.OccurredAt.ToString("yyyy-MM-dd HH:mm")</span>
                                </div>
                                <div>@item.Description</div>
                                <div class="small text-muted">
                                    @item.Location
                                    @if (item.TemperatureCelsius.HasValue)
                                    {
                                        <span class="ms-2 @(item.IsTemperatureException ? "text-danger fw-semibold" : null)">
                                            @item.TemperatureCelsius.Value.ToString("F1")℃
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        @if (Model.CanShip)
        {
            <div class="content-card">
                <div class="content-card-header">
                    <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8h2a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H8"/><path d="M4 6h9a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-2"/><circle cx="7" cy="17" r="3"/><path d="M3 6V4a1 1 0 0 1 1-1h4"/></svg> 登记发货</h5>
                </div>
                <form asp-action="Ship" asp-route-id="@Model.Order.OrderId" method="post" class="content-card-body">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="SupplierId" value="@Model.SupplierId" />
                    <div class="mb-3">
                        <label class="form-label">物流公司</label>
                        <input class="form-control" name="CarrierName" maxlength="100" placeholder="不填则使用配置化兜底承运商" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">物流公司代码</label>
                        <input class="form-control" name="CarrierCode" maxlength="30" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">运单号</label>
                        <input class="form-control" name="TrackingNo" maxlength="100" placeholder="不填则使用 A 组生成的运单号" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">包裹温区</label>
                        <select class="form-select" name="PackageTemperature" required>
                            <option value="CHILLED">冷藏（0～8℃）</option>
                            <option value="FROZEN">冷冻（≤-18℃）</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">预计送达</label>
                        <input class="form-control" type="datetime-local" name="EstimatedArrivalAt" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">发货备注</label>
                        <textarea class="form-control" name="Remark" maxlength="300" rows="2"></textarea>
                    </div>
                    <button class="btn btn-success w-100" type="submit">确认发货</button>
                </form>
            </div>
        }
        else
        {
            <div class="content-card">
                <div class="content-card-header">
                    <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7h11v9H2z"/><path d="M13 10h4l3 3v3h-7z"/><circle cx="6" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg> 物流信息</h5>
                </div>
                <div class="content-card-body">
                    <div class="info-row"><div class="info-label">承运商</div><div class="info-value">@(logistics.CarrierName ?? "-")</div></div>
                    <div class="info-row"><div class="info-label">运单号</div><div class="info-value">@(logistics.TrackingNo ?? "-")</div></div>
                    <div class="info-row"><div class="info-label">包裹温区</div><div class="info-value">@logistics.PackageTemperature</div></div>
                    <div class="info-row"><div class="info-label">发货时间</div><div class="info-value">@(logistics.ShippedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</div></div>
                    <div class="info-row"><div class="info-label">预计送达</div><div class="info-value">@(logistics.EstimatedArrivalAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</div></div>
                </div>
            </div>

            @if (logistics.StatusCode is not LogisticsStatusCodes.Delivered and not LogisticsStatusCodes.Returned)
            {
                <div class="content-card mt-3">
                    <div class="content-card-header">
                        <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="19" r="2"/><circle cx="18" cy="5" r="2"/><path d="M8 19h7a4 4 0 0 0 0-8H9a4 4 0 0 1 0-8h5"/><path d="M20 14v4M18 16h4"/></svg> 追加物流轨迹</h5>
                    </div>
                    <form asp-action="AddTrackingEvent" asp-route-id="@Model.Order.OrderId" method="post" class="content-card-body">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="EventId" value="@GroupBIds.NewId()" />
                        <input type="hidden" name="OrderId" value="@Model.Order.OrderId" />
                        <input type="hidden" name="SupplierId" value="@Model.SupplierId" />
                        <div class="mb-3">
                            <label class="form-label">新状态</label>
                            <select class="form-select" name="StatusCode" required>
                                @if (nextStatuses.Count == 0)
                                {
                                    <option value="">当前状态无下一步可选</option>
                                }
                                @foreach (var option in nextStatuses)
                                {
                                    <option value="@option.Code">@option.Name</option>
                                }
                            </select>
                            <small class="text-muted">
                                当前：@LogisticsStatusCodes.GetName(logistics.StatusCode)，仅可推进到上方所列状态。
                                正常顺序：已发货 → 运输中 → 派送中 → 已签收（已签收/已退回为终态）。
                            </small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">发生地点</label>
                            <input class="form-control" name="Location" maxlength="200" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">轨迹描述</label>
                            <textarea class="form-control" name="Description" maxlength="500" rows="2" required></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">采集温度（℃）</label>
                            <input class="form-control" type="number" step="0.1" name="TemperatureCelsius" />
                        </div>
                        <input type="hidden" name="OccurredAt" value="@DateTime.Now.ToString("s")" />
                        <button class="btn btn-outline-primary w-100" type="submit">更新轨迹</button>
                    </form>
                </div>
            }
        }
    </div>
</div>
