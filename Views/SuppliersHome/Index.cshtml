@{
    ViewData["Title"] = "供应商首页";
}

<div class="text-center my-5">
    <h1 class="display-4">生鲜冷链团购分销供应链系统</h1>
    <p class="lead text-muted">数据库课程设计项目</p>
</div>

<div class="row g-4 mt-3">
    <div class="col-md-4">
        <div class="card text-center h-100 shadow-sm">
            <div class="card-body">
                <h3 class="card-title">📦</h3>
                <h5>产品与库存</h5>
                <p class="text-muted">管理产品信息、库存出入库、低库存预警</p>
                <a class="btn btn-primary" asp-controller="Products" asp-action="Index">进入管理</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center h-100 shadow-sm">
            <div class="card-body">
                <h3 class="card-title">🏭</h3>
                <h5>供应商入口</h5>
                <p class="text-muted">供应商登录，维护自己产品的供货价</p>
                <a class="btn btn-primary" asp-controller="Suppliers" asp-action="Login">供应商登录</a>
            </div>
        </div>
    </div>
</div>
