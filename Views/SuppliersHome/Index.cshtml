@{
    Layout = "_SupplierPortalLayout";
    ViewData["Title"] = "供应商首页";
}

<div class="text-center py-5">
    <div class="display-6 mb-2">欢迎，@Context.Session.GetString("SupplierName")</div>
    <p class="text-muted">请使用左侧菜单管理您的货物、定价规则与物流发货。</p>
</div>

<div class="card border-primary">
    <div class="card-body d-flex justify-content-between align-items-center gap-3">
        <div>
            <h5 class="mb-1">📋 订单履约</h5>
            <p class="text-muted mb-0">查看本供应商待发货订单，完成冷链出库与真实物流登记。</p>
        </div>
        <a class="btn btn-primary" asp-controller="SupplierFulfillment" asp-action="Index">进入履约工作台</a>
    </div>
</div>
