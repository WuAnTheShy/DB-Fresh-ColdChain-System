@model PagedResult<OrderResultDto>
@{
    ViewData["Title"] = "订单管理";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>📋 订单列表</h3>
    <a class="btn btn-success" asp-action="Create">创建订单</a>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="status" class="form-select">
            <option value="">全部状态</option>
            <option value="1" selected="@(ViewBag.CurrentStatus == 1)">待确认</option>
            <option value="2" selected="@(ViewBag.CurrentStatus == 2)">已确认</option>
            <option value="3" selected="@(ViewBag.CurrentStatus == 3)">配送中</option>
            <option value="4" selected="@(ViewBag.CurrentStatus == 4)">已完成</option>
            <option value="5" selected="@(ViewBag.CurrentStatus == 5)">已取消</option>
        </select>
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-primary">筛选</button></div>
</form>
<table class="table table-striped table-hover">
    <thead class="table-dark"><tr><th>ID</th><th>订单号</th><th>团长</th><th>金额</th><th>状态</th><th>时间</th><th>操作</th></tr></thead>
    <tbody>
    @if (Model.Items.Any())
    {
        @foreach (var o in Model.Items)
        {
            <tr>
                <td>@o.Id</td><td>@o.OrderNo</td><td>@o.GroupLeaderName</td>
                <td>¥@o.TotalAmount.ToString("F2")</td><td>@o.StatusName</td>
                <td>@o.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
                <td><a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@o.Id">详情</a></td>
            </tr>
        }
    }
    else
    {
        <tr><td colspan="7" class="text-center">暂无数据</td></tr>
    }
    </tbody>
</table>
@await Html.PartialAsync("_Pagination", Model)
