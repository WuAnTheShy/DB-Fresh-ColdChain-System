@model OrderResultDto
@{
    ViewData["Title"] = $"订单详情 — {Model.OrderNo}";
}
<h3>📋 订单 @Model.OrderNo</h3>
<div class="row">
    <div class="col-md-6">
        <table class="table table-bordered">
            <tr><th style="width:100px">订单ID</th><td>@Model.Id</td></tr>
            <tr><th>团长</th><td>@Model.GroupLeaderName</td></tr>
            <tr><th>金额</th><td>¥@Model.TotalAmount.ToString("F2")</td></tr>
            <tr><th>状态</th><td>@Model.StatusName</td></tr>
            <tr><th>备注</th><td>@Model.Remark</td></tr>
            <tr><th>创建时间</th><td>@Model.CreateTime.ToString("yyyy-MM-dd HH:mm")</td></tr>
        </table>
        @if (Model.Status == 1)
        {
            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" style="display:inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger" onclick="return confirm('确定取消？')">取消订单</button>
            </form>
        }
    </div>
</div>
<h5 class="mt-3">订单明细</h5>
<table class="table table-striped">
    <thead class="table-secondary"><tr><th>产品</th><th>数量</th><th>单价</th><th>小计</th></tr></thead>
    <tbody>
    @foreach (var item in Model.Items)
    {
        <tr><td>@item.ProductName</td><td>@item.Quantity</td><td>¥@item.UnitPrice.ToString("F2")</td><td>¥@item.Subtotal.ToString("F2")</td></tr>
    }
    </tbody>
</table>
<a class="btn btn-outline-secondary" asp-action="Index">返回</a>
