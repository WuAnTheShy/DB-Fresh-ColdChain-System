@model List<OrderResultDto>
@{
    ViewData["Title"] = $"团长 #{ViewBag.LeaderId} 的订单";
}
<h3>团长 #@ViewBag.LeaderId 的订单</h3>
<table class="table table-striped">
    <thead class="table-dark"><tr><th>ID</th><th>订单号</th><th>金额</th><th>状态</th><th>时间</th><th>操作</th></tr></thead>
    <tbody>
    @foreach (var o in Model)
    {
        <tr><td>@o.Id</td><td>@o.OrderNo</td><td>¥@o.TotalAmount.ToString("F2")</td><td>@o.StatusName</td>
            <td>@o.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
            <td><a class="btn btn-sm btn-info" asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id">详情</a></td></tr>
    }
    </tbody>
</table>
<a class="btn btn-outline-secondary" asp-controller="GroupLeaders" asp-action="Index">返回</a>
