@model List<OrderResultDto>
@{
    ViewData["Title"] = "物流配送";
}
<h3>🚚 待配送订单</h3>
<table class="table table-striped table-hover">
    <thead class="table-dark"><tr><th>ID</th><th>订单号</th><th>团长</th><th>金额</th><th>时间</th><th>操作</th></tr></thead>
    <tbody>
    @if (Model.Any())
    {
        @foreach (var o in Model)
        {
            <tr>
                <td>@o.Id</td><td>@o.OrderNo</td><td>@o.GroupLeaderName</td>
                <td>¥@o.TotalAmount.ToString("F2")</td>
                <td>@o.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    <form asp-action="StartDelivery" asp-route-orderId="@o.Id" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-primary">开始配送</button>
                    </form>
                </td>
            </tr>
        }
    }
    else
    {
        <tr><td colspan="6" class="text-center">暂无待配送订单</td></tr>
    }
    </tbody>
</table>

<h4 class="mt-4">查看团长配送汇总</h4>
<form asp-action="Summary" method="get" class="row g-2">
    <div class="col-auto"><input type="number" name="leaderId" class="form-control" placeholder="团长ID" required /></div>
    <div class="col-auto"><button type="submit" class="btn btn-primary">查询</button></div>
</form>
