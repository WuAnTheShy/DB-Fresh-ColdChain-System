@model AddressUpsertRequest
@{
    ViewData["Title"] = "编辑收货地址";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="mb-4">
                <h1 class="h3 mb-2">编辑收货地址</h1>
                <p class="text-muted mb-0">地址 #@Model.AddressId · 消费者 #@Model.CustomerId</p>
            </div>
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="EditAddress" asp-route-id="@Model.AddressId"
                          method="post" novalidate>
                        <partial name="_AddressFields" model="Model" />
                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">保存地址</button>
                            <a asp-action="Addresses" asp-route-customerId="@Model.CustomerId"
                               class="btn btn-outline-secondary">取消</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
