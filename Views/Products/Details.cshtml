@model ProductDto
@{
    ViewData["Title"] = $"产品 — {Model.ProductName}";
    var media = ViewBag.Media as ProductSupplierMediaDto ?? new ProductSupplierMediaDto();
}

<div class="page-hero">
    <div>
        <div class="hero-greeting">@Model.ProductName</div>
        <div class="hero-meta">
            <span class="text-white-50">@Model.CategoryName · 单位 @Model.Unit</span>
        </div>
    </div>
    <div class="hero-actions">
        <a class="btn btn-light btn-sm" asp-action="Edit" asp-route-id="@Model.ProductID">编辑</a>
        <a class="btn btn-outline-light btn-sm" asp-action="Inventory" asp-route-productId="@Model.ProductID">库存管理</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="content-card h-100">
            <div class="content-card-header">
                <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg> 商品信息</h5>
            </div>
            <div class="content-card-body">
                <div class="info-row"><div class="info-label">编号</div><div class="info-value"><code class="order-id">@Model.ProductID</code></div></div>
                <div class="info-row"><div class="info-label">名称</div><div class="info-value">@Model.ProductName</div></div>
                <div class="info-row"><div class="info-label">分类</div><div class="info-value">@Model.CategoryName</div></div>
                <div class="info-row"><div class="info-label">单位</div><div class="info-value">@Model.Unit</div></div>
                <div class="info-row"><div class="info-label">重量</div><div class="info-value">@Model.WeightKG kg</div></div>
                <div class="info-row"><div class="info-label">体积</div><div class="info-value">@Model.VolumeLitre L</div></div>
                <div class="info-row"><div class="info-label">保质期</div><div class="info-value">@Model.ExpiryHours 小时</div></div>
                <div class="info-row"><div class="info-label">温区</div><div class="info-value">@Model.StorageReq</div></div>
                <div class="info-row"><div class="info-label">可用库存</div><div class="info-value">@Model.AvailableStock</div></div>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="content-card h-100">
            <div class="content-card-header">
                <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg> 供应商图文</h5>
            </div>
            <div class="content-card-body">
                @if (media.Suppliers.Any())
                {
                    <form method="get" asp-action="Details" class="mb-3">
                        <input type="hidden" name="id" value="@Model.ProductID" />
                        <div class="d-flex gap-2">
                            <select name="supplierId" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="">— 选择供应商 —</option>
                                @foreach (var s in media.Suppliers)
                                {
                                    <option value="@s.SupplierID" selected="@(s.SupplierID == media.SelectedSupplierID)">@s.SupplierName</option>
                                }
                            </select>
                        </div>
                    </form>

                    @if (!string.IsNullOrEmpty(media.SelectedSupplierID))
                    {
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @if (media.Images.Any())
                            {
                                foreach (var img in media.Images)
                                {
                                    <img src="@img" alt="@Model.ProductName" class="product-detail-thumb" onerror="this.style.display='none'" />
                                }
                            }
                            else
                            {
                                <span class="text-muted small">该供应商暂无图片</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(media.Description))
                        {
                            <div class="text-muted small mb-1"><b>@media.SelectedSupplierName 的商品简介：</b></div>
                            <div style="white-space:pre-wrap;">@media.Description</div>
                        }
                        else
                        {
                            <div class="text-muted small">该供应商暂未填写商品简介。</div>
                        }
                    }
                    else
                    {
                        <div class="text-muted small">请先选择供应商，查看其商品简介与图片。</div>
                    }
                }
                else
                {
                    <span class="text-muted">暂无供应商供货该商品。请供应商先在「我的货物」对该物品建立货物（售价即供货价），并可在货物行维护商品图文。</span>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a class="btn btn-outline-secondary" asp-action="Index">返回</a>
</div>

@section Scripts {
    <style>
        .product-detail-thumb { width: 120px; height: 120px; object-fit: cover; border-radius: 8px; border: 1px solid #e5e7eb; }
    </style>
}
