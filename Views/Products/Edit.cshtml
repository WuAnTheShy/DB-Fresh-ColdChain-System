@model UpdateProductDto
@{
    ViewData["Title"] = "编辑产品";
    var categories = (ViewBag.Categories as List<CategoryDto>) ?? new List<CategoryDto>();
    var platformImages = (ViewBag.ProductImages as List<InvProductImage>) ?? new List<InvProductImage>();
    var productId = ViewBag.ProductId as string ?? "";
}
<h3>编辑产品</h3>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="col-md-7">
    <!-- 平台通用图：可逐张删除（独立表单，避免嵌套在下方保存表单内） -->
    @if (platformImages.Any())
    {
        <div class="card mb-3">
            <div class="card-body">
                <h6 class="mb-2">已上传的商品图片（平台通用图）</h6>
                <div class="d-flex flex-wrap gap-2 mb-1">
                    @foreach (var img in platformImages)
                    {
                        <div class="position-relative">
                            <img src="@img.ImageUrl" alt="@Model.ProductName" class="product-img-box" onerror="this.style.display='none'" />
                            <form asp-action="DeleteImage" asp-route-id="@productId" method="post"
                                  class="position-absolute top-0 end-0"
                                  onsubmit="return confirm('确定删除这张图片吗？删除后无法恢复。');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="imageId" value="@img.ImageID" />
                                <button type="submit" class="product-img-del" title="删除该图">×</button>
                            </form>
                        </div>
                    }
                </div>
                <small class="text-muted d-block">第一张为商品主图；如需调整顺序，可删除后重新上传。供应商在「我的货物」上传的货物图不在此管理。</small>
            </div>
        </div>
    }

    <form asp-action="Edit" method="post" enctype="multipart/form-data" id="productForm">
        @Html.AntiForgeryToken()
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
        }

        <div class="mb-3">
            <label class="form-label">名称 <span class="text-danger">*</span></label>
            <input asp-for="ProductName" class="form-control" required maxlength="100" />
        </div>
        <div class="mb-3">
            <label class="form-label">分类 <span class="text-danger">*</span></label>
            <select asp-for="CategoryID" class="form-select" required>
                <option value="">-- 请选择分类（如 水果 / 蔬菜 / 肉蛋）--</option>
                @foreach (var c in categories)
                {
                    <option value="@c.CategoryID">@c.CategoryName</option>
                }
            </select>
        </div>
        <div class="mb-3"><label class="form-label">单位</label><input asp-for="Unit" class="form-control" maxlength="20" placeholder="斤 / 盒 / 箱" /></div>
        <div class="row g-3 mb-3">
            <div class="col-md-6"><label class="form-label">重量(kg)</label><input asp-for="WeightKG" class="form-control" type="number" step="0.01" min="0" /></div>
            <div class="col-md-6"><label class="form-label">体积(L)</label><input asp-for="VolumeLitre" class="form-control" type="number" step="0.01" min="0" /></div>
        </div>
        <div class="alert alert-info py-2 small mb-4">
            保质期、温区与文字介绍由<b>各供应商在上架（我的货物）时自行填写</b>（不同供应商可不同），此处仅登记商品品类信息。
        </div>

        <!-- 商品图片：新增队列随保存提交（追加到现有平台通用图之后） -->
        <div class="mb-3">
            <label class="form-label">新增商品图片</label>
            @if (!platformImages.Any())
            {
                <p class="text-muted small mb-1">该商品暂无平台通用图，请在下方上传。</p>
            }
            <div class="d-flex align-items-center gap-2">
                <input type="file" name="images" id="images" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif" multiple />
                <button type="button" id="clearImages" class="btn btn-outline-danger btn-sm" style="white-space:nowrap;">清空已选</button>
            </div>
            <small class="text-muted">不选择图片则保留现有图片；选择后可<b>多次选择</b>累积追加，最多 9 张，自动去重。</small>
            <div id="preview" class="d-flex flex-wrap gap-2 mt-2"></div>
            <div id="fileTip" class="form-text text-danger d-none"></div>
        </div>

        <button type="submit" class="btn btn-primary" id="submitBtn">保存</button>
        <a class="btn btn-outline-secondary" asp-action="Index">取消</a>
    </form>
</div>

@section Scripts {
    <style>
        .product-img-box { width: 88px; height: 88px; object-fit: cover; border-radius: 8px; border: 1px solid #dee2e6; }
        .product-img-remove { background: rgba(0,0,0,0.55); border: none; border-radius: 0 8px 0 8px; line-height: 1; padding: 3px 8px; font-size: 13px; }
        .product-img-del { background: rgba(220,53,69,0.9); color: #fff; border: none; border-radius: 0 8px 0 8px; line-height: 1; padding: 3px 9px; font-size: 16px; }
    </style>
    <script>
        (function () {
            const input = document.getElementById('images');
            const preview = document.getElementById('preview');
            const tip = document.getElementById('fileTip');
            const form = document.getElementById('productForm');
            const clearBtn = document.getElementById('clearImages');
            const submitBtn = document.getElementById('submitBtn');

            const MAX_COUNT = 9;
            const MAX_BYTES = 5 * 1024 * 1024; // 5MB

            // 图片缓存队列：追加到现有图片之后，随表单一次性提交
            const pending = [];

            function renderPreview() {
                preview.innerHTML = '';
                pending.forEach((file, index) => {
                    if (!file.type.startsWith('image/')) return;
                    const url = URL.createObjectURL(file);
                    const wrap = document.createElement('div');
                    wrap.className = 'position-relative';
                    const badge = '<span class="position-absolute top-0 start-0 badge text-bg-dark" style="font-size:11px;">新增' + (index + 1) + '</span>';
                    wrap.innerHTML = '<img src="' + url + '" class="product-img-box" />' +
                        badge +
                        '<button type="button" title="移除该图" class="position-absolute top-0 end-0 text-white product-img-remove">×</button>';
                    wrap.querySelector('button').addEventListener('click', function () {
                        pending.splice(index, 1);
                        renderPreview();
                    });
                    preview.appendChild(wrap);
                });
            }

            input.addEventListener('change', function () {
                const added = [];
                for (const f of input.files || []) {
                    if (!f.type.startsWith('image/')) continue;
                    if (pending.length + added.length >= MAX_COUNT) break;
                    if (f.size > MAX_BYTES) { alert('「' + f.name + '」超过 5MB，已忽略。'); continue; }
                    const dup = pending.some(p => p.name === f.name && p.size === f.size && p.lastModified === f.lastModified);
                    if (!dup) added.push(f);
                }
                if (added.length > 0) {
                    pending.push(...added);
                    renderPreview();
                }
                input.value = ''; // 允许再次选择同一批文件时仍触发 change
            });

            clearBtn.addEventListener('click', function () {
                pending.length = 0;
                renderPreview();
            });

            form.addEventListener('submit', function (e) {
                tip.classList.add('d-none');
                if (pending.length > 0) {
                    // 把图片缓存队列写入 file input，随表单提交
                    const dt = new DataTransfer();
                    pending.forEach(f => dt.items.add(f));
                    input.files = dt.files;
                    pending.length = 0;
                    renderPreview();
                    submitBtn.disabled = true;
                    submitBtn.textContent = '保存中…';
                }
            });
        })();
    </script>
}
