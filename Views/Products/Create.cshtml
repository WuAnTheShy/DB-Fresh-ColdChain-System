@model CreateProductDto
@{
    ViewData["Title"] = "新增产品";
    var categories = (ViewBag.Categories as List<CategoryDto>) ?? new List<CategoryDto>();
}

<div class="page-hero">
    <div>
        <div class="hero-greeting">新增产品</div>
        <div class="hero-meta">
            <span class="text-white-50">分类与商品图片会同步展示给供应商、团长与消费者端；第一张图片将作为商品主图</span>
        </div>
    </div>
</div>

<div class="content-card">
    <div class="content-card-header">
        <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h12a2 2 0 0 1 2 2v16l-4-2-4 2-4-2-4 2V4a2 2 0 0 1 2-2z"/><path d="M8 8h8M8 12h8"/></svg> 商品信息</h5>
        <span class="text-muted small">带 <span class="text-danger">*</span> 为必填</span>
    </div>
    <div class="content-card-body">
        <div class="row">
            <div class="col-lg-7">
                <form asp-action="Create" method="post" enctype="multipart/form-data" id="productForm">
                    @Html.AntiForgeryToken()
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
                    }

                    <div class="mb-3">
                        <label class="form-label">名称 <span class="text-danger">*</span></label>
                        <input asp-for="ProductName" class="form-control" required maxlength="100" placeholder="例如：智利进口车厘子" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">分类 <span class="text-danger">*</span></label>
                        <select asp-for="CategoryID" class="form-select" required>
                            <option value="">-- 请选择分类（如 水果 / 蔬菜 / 肉蛋）--</option>
                            @foreach (var c in categories)
                            {
                                <option value="@c.CategoryID">@c.CategoryName</option>
                            }
                        </select>
                        @if (!categories.Any())
                        {
                            <small class="text-danger">暂无可用分类，请先在分类管理中创建。</small>
                        }
                    </div>
                    <div class="mb-3"><label class="form-label">单位</label><input asp-for="Unit" class="form-control" maxlength="20" placeholder="斤 / 盒 / 箱" /></div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6"><label class="form-label">重量(kg)</label><input asp-for="WeightKG" class="form-control" type="number" step="0.01" min="0" /></div>
                        <div class="col-md-6"><label class="form-label">体积(L)</label><input asp-for="VolumeLitre" class="form-control" type="number" step="0.01" min="0" /></div>
                    </div>
                    <div class="alert alert-info py-2 small mb-4">
                        保质期、温区与文字介绍由<b>各供应商在上架（我的货物）时自行填写</b>（不同供应商可不同），此处仅登记商品品类信息。
                    </div>

                    <!-- 商品图片：浏览器端图片缓存队列，选择→预览→随表单一次性提交 -->
                    <div class="mb-3">
                        <label class="form-label">商品图片（至少 1 张）<span class="text-danger">*</span></label>
                        <div class="d-flex align-items-center gap-2">
                            <input type="file" name="images" id="images" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif" multiple />
                            <button type="button" id="clearImages" class="btn btn-outline-danger btn-sm" style="white-space:nowrap;">清空已选</button>
                        </div>
                        <small class="text-muted">可<b>多次选择</b>图片累积上传（自动去重），已选 <span id="fileCount">0</span> 张，最多 9 张；第一张将作为商品主图。</small>
                        <div id="preview" class="d-flex flex-wrap gap-2 mt-2"></div>
                        <div id="fileTip" class="form-text text-danger d-none">请选择至少 1 张图片后再提交。</div>
                    </div>

                    <button type="submit" class="btn btn-success" id="submitBtn">创建</button>
                    <a class="btn btn-outline-secondary" asp-action="Index">取消</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .product-img-box { width: 96px; height: 96px; object-fit: cover; border-radius: 8px; border: 1px solid #dee2e6; }
        .product-img-remove { background: rgba(0,0,0,0.55); border: none; border-radius: 0 8px 0 8px; line-height: 1; padding: 3px 8px; font-size: 13px; }
    </style>
    <script>
        (function () {
            const input = document.getElementById('images');
            const preview = document.getElementById('preview');
            const tip = document.getElementById('fileTip');
            const form = document.getElementById('productForm');
            const clearBtn = document.getElementById('clearImages');
            const countEl = document.getElementById('fileCount');
            const submitBtn = document.getElementById('submitBtn');

            const MAX_COUNT = 9;
            const MAX_BYTES = 5 * 1024 * 1024; // 5MB

            // 图片缓存队列：多次选择追加、按 名称+大小+修改时间 去重，可删除单张/清空
            const pending = [];

            function renderPreview() {
                preview.innerHTML = '';
                pending.forEach((file, index) => {
                    if (!file.type.startsWith('image/')) return;
                    const url = URL.createObjectURL(file);
                    const wrap = document.createElement('div');
                    wrap.className = 'position-relative';
                    const badge = index === 0
                        ? '<span class="position-absolute top-0 start-0 badge text-bg-success" style="font-size:11px;">主图</span>'
                        : '<span class="position-absolute top-0 start-0 badge text-bg-dark" style="font-size:11px;">' + (index + 1) + '</span>';
                    wrap.innerHTML = '<img src="' + url + '" class="product-img-box" />' +
                        badge +
                        '<button type="button" title="移除该图" class="position-absolute top-0 end-0 text-white product-img-remove">×</button>';
                    wrap.querySelector('button').addEventListener('click', function () {
                        pending.splice(index, 1);
                        renderPreview();
                    });
                    preview.appendChild(wrap);
                });
                countEl.textContent = pending.length;
            }

            input.addEventListener('change', function () {
                const added = [];
                for (const f of input.files || []) {
                    if (!f.type.startsWith('image/')) continue;
                    if (pending.length + added.length >= MAX_COUNT) break;
                    if (f.size > MAX_BYTES) { alert('「' + f.name + '」超过 5MB，已忽略。'); continue; }
                    const dup = pending.some(p => p.name === f.name && p.size === f.size && p.lastModified === f.lastModified);
                    if (!dup) added.push(f);
                }
                if (added.length > 0) {
                    pending.push(...added);
                    renderPreview();
                }
                input.value = ''; // 允许再次选择同一批文件时仍触发 change
            });

            clearBtn.addEventListener('click', function () {
                pending.length = 0;
                renderPreview();
            });

            form.addEventListener('submit', function (e) {
                if (pending.length < 1) {
                    e.preventDefault();
                    tip.classList.remove('d-none');
                    return;
                }
                tip.classList.add('d-none');

                // 把图片缓存队列写入 file input，随表单一并提交
                const dt = new DataTransfer();
                pending.forEach(f => dt.items.add(f));
                input.files = dt.files;

                // 提交后立即清空队列并禁用按钮，防止重复提交
                pending.length = 0;
                renderPreview();
                submitBtn.disabled = true;
                submitBtn.textContent = '提交中…';
            });
        })();
    </script>
}
