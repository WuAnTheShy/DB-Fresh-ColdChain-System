@model CreateProductDto
@{ ViewData["Title"] = "新增产品"; }
<h3>新增产品</h3>
<div class="col-md-6">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3"><label class="form-label">名称</label><input asp-for="ProductName" class="form-control" required /></div>
        <div class="mb-3"><label class="form-label">分类ID</label><input asp-for="CategoryID" class="form-control" /></div>
        <div class="mb-3"><label class="form-label">供应商ID</label><input asp-for="SupplierID" class="form-control" /></div>
        <div class="mb-3"><label class="form-label">单位</label><input asp-for="Unit" class="form-control" /></div>
        <div class="mb-3"><label class="form-label">重量(kg)</label><input asp-for="WeightKG" class="form-control" type="number" step="0.01" /></div>
        <div class="mb-3"><label class="form-label">体积(L)</label><input asp-for="VolumeLitre" class="form-control" type="number" step="0.01" /></div>
        <div class="mb-3"><label class="form-label">保质期(小时)</label><input asp-for="ExpiryHours" class="form-control" type="number" /></div>
        <div class="mb-3"><label class="form-label">存储温区</label><input asp-for="StorageReq" class="form-control" placeholder="常温/冷藏/冷冻" /></div>
        <div class="mb-3"><label class="form-label">默认价格</label><input asp-for="DefaultPrice" class="form-control" type="number" step="0.01" required /></div>
        <div class="mb-3"><label class="form-label">初始库存</label><input asp-for="InitialStock" class="form-control" type="number" required /></div>
        <button type="submit" class="btn btn-success">创建</button>
        <a class="btn btn-outline-secondary" asp-action="Index">取消</a>
    </form>
</div>
