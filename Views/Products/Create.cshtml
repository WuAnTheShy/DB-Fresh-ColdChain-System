@model CreateProductDto
@{
    ViewData["Title"] = "新增产品";
}

<h3>新增产品</h3>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label class="form-label">名称</label>
                <input asp-for="Name" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">分类</label>
                <input asp-for="Category" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">单位</label>
                <input asp-for="Unit" class="form-control" placeholder="斤/件/箱" />
            </div>
            <div class="mb-3">
                <label class="form-label">单价</label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" required />
            </div>
            <div class="mb-3">
                <label class="form-label">图片URL</label>
                <input asp-for="ImageUrl" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">供应商ID</label>
                <input asp-for="SupplierId" class="form-control" type="number" required />
            </div>
            <div class="mb-3">
                <label class="form-label">初始库存</label>
                <input asp-for="InitialStock" class="form-control" type="number" required />
            </div>
            <button type="submit" class="btn btn-success">创建</button>
            <a class="btn btn-outline-secondary" asp-action="Index">取消</a>
        </form>
    </div>
</div>
