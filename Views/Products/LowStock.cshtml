@model List<InventoryDto>
@{
    ViewData["Title"] = "低库存预警";
}

<div class="page-hero">
    <div>
        <div class="hero-greeting">低库存预警</div>
        <div class="hero-meta">
            <span class="text-white-50">可用库存低于阈值 @ViewBag.Threshold 的商品</span>
        </div>
    </div>
</div>

<div class="content-card">
    <div class="content-card-header">
        <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 2 20h20L12 3z"/><path d="M12 9v5M12 17h.01"/></svg> 预警清单</h5>
        <span class="text-muted small">共 @Model.Count 项</span>
    </div>
    <div class="content-card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>产品</th>
                            <th>总库存</th>
                            <th>锁定</th>
                            <th>可用</th>
                            <th>更新时间</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@i.ProductName</td>
                                <td>@i.TotalQty</td>
                                <td>@i.LockedQty</td>
                                <td><span class="badge bg-danger">@i.AvailableQty</span></td>
                                <td class="small text-muted">@i.UpdateTime.ToString("yyyy-MM-dd HH:mm")</td>
                                <td><a class="btn btn-sm btn-outline-secondary" asp-action="Inventory" asp-route-productId="@i.ProductID">管理</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
                <p>暂无低库存产品，库存充足。</p>
            </div>
        }
    </div>
</div>

<div class="mt-3">
    <a class="btn btn-outline-secondary" asp-action="Index">返回</a>
</div>
