@model InventoryDto
@{
    ViewData["Title"] = $"库存 — {Model.ProductName}";
    var batches = ViewBag.Batches as List<StockBatchDto> ?? new();
    var supplierOptions = ViewBag.SupplierOptions as List<SupplierQuoteOptionDto> ?? new();
}

<div class="page-hero">
    <div>
        <div class="hero-greeting">库存管理</div>
        <div class="hero-meta">
            <span class="text-white-50">@Model.ProductName</span>
        </div>
    </div>
</div>

<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-card-top">
            <div class="stat-icon bg-success-subtle text-success"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg></div>
            <div class="stat-label">总库存</div>
        </div>
        <div class="stat-value">@Model.TotalQty</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-top">
            <div class="stat-icon bg-warning-subtle text-warning"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div>
            <div class="stat-label">锁定库存</div>
        </div>
        <div class="stat-value">@Model.LockedQty</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-top">
            <div class="stat-icon bg-info-subtle text-info"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
            <div class="stat-label">可用库存</div>
        </div>
        <div class="stat-value">@Model.AvailableQty</div>
        <div class="stat-sub">更新于 @Model.UpdateTime.ToString("yyyy-MM-dd HH:mm")</div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="content-card">
            <div class="content-card-header">
                <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v14"/><path d="m7 12 5 5 5-5"/><path d="M5 21h14"/></svg> 入库</h5>
            </div>
            <div class="content-card-body">
                @if (supplierOptions.Any())
                {
                    <form asp-action="StockIn" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.ProductID" />
                        <div class="mb-2">
                            <select name="supplierId" id="supplierSelect" class="form-select form-select-sm" required>
                                <option value="">-- 选择供应商 --</option>
                                @foreach (var o in supplierOptions)
                                {
                                    <option value="@o.SupplierID" data-shelfhours="@(o.ShelfLifeHours?.ToString() ?? "")">@o.SupplierName（供货价 ¥@o.SupplyPrice.ToString("F2")@(o.ShelfLifeHours.HasValue ? $"，保质期 {o.ShelfLifeHours / 24.0:0.#} 天" : "")）</option>
                                }
                            </select>
                        </div>
                        <div class="mb-2"><input type="number" name="quantity" class="form-control" placeholder="数量" required /></div>
                        <div class="mb-2"><input type="text" name="batchNo" class="form-control" placeholder="批次号（留空自动生成）" /></div>
                        <div class="mb-2"><small class="text-muted">进价自动取所选供应商的供货价</small></div>
                        <div class="row mb-2">
                            <div class="col-6">
                                <input type="date" name="productionDate" id="productionDate" class="form-control" placeholder="生产日期（货品标签）" required />
                            </div>
                            <div class="col-6 d-flex align-items-center">
                                <small class="text-muted">过期日期（自动计算）：<span id="expiryHint">选供应商并填生产日期后显示</span></small>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-success">确认入库</button>
                    </form>
                    <script>
                        function calcExpiry() {
                            const sel = document.getElementById('supplierSelect');
                            const opt = sel && sel.selectedOptions[0];
                            const hours = opt ? parseInt(opt.dataset.shelfhours || '0', 10) : 0;
                            const pd = document.getElementById('productionDate').value;
                            const el = document.getElementById('expiryHint');
                            if (!hours || !pd) {
                                el.textContent = '选供应商并填生产日期后显示';
                                return;
                            }
                            const d = new Date(pd + 'T00:00:00');
                            d.setHours(d.getHours() + hours);
                            el.textContent = d.toLocaleDateString('zh-CN');
                        }
                        document.getElementById('supplierSelect').addEventListener('change', calcExpiry);
                        document.getElementById('productionDate').addEventListener('change', calcExpiry);
                    </script>
                }
                else
                {
                    <div class="alert alert-warning py-2 mb-0">该产品暂无供应商建立货物，无法入库。请供应商先在「我的货物」对该物品建立货物（售价即供货价）后重试。</div>
                }
            </div>
        </div>

        <div class="content-card mt-3">
            <div class="content-card-header">
                <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21v-14"/><path d="m7 12 5-5 5 5"/><path d="M5 3h14"/></svg> 出库 (FEFO)</h5>
            </div>
            <div class="content-card-body">
                <form asp-action="StockOut" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.ProductID" />
                    @if (supplierOptions.Count > 1)
                    {
                        <div class="mb-2">
                            <select name="supplierId" class="form-select form-select-sm">
                                <option value="">-- 全部供应商（按商品 FEFO）--</option>
                                @foreach (var o in supplierOptions)
                                {
                                    <option value="@o.SupplierID">@o.SupplierName（供货价 ¥@o.SupplyPrice.ToString("F2")）</option>
                                }
                            </select>
                            <small class="text-muted">同一商品存在多个供应商供货时，建议指定供应商出库，避免扣错货。</small>
                        </div>
                    }
                    <div class="mb-2"><input type="number" name="quantity" class="form-control" placeholder="数量" required /></div>
                    <button type="submit" class="btn btn-warning">确认出库</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="content-card">
            <div class="content-card-header">
                <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="6" rx="1"/><rect x="3" y="14" width="18" height="6" rx="1"/></svg> 批次明细</h5>
                <span class="text-muted small">共 @batches.Count 批</span>
            </div>
            <div class="content-card-body p-0">
                @if (batches.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>批号</th>
                                    <th>供应商</th>
                                    <th>生产日期</th>
                                    <th>过期日期</th>
                                    <th>进价</th>
                                    <th>当前数量</th>
                                    <th>状态</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in batches)
                                {
                                    <tr>
                                        <td><code class="order-id">@b.BatchNo</code></td>
                                        <td>@(b.SupplierName ?? "-")</td>
                                        <td class="small text-muted">@b.ProductionDate?.ToString("yyyy-MM-dd")</td>
                                        <td class="small text-muted">@b.ExpiryDate?.ToString("yyyy-MM-dd")</td>
                                        <td>@(b.InPrice > 0 ? $"¥{b.InPrice:F2}" : "-")</td>
                                        <td class="fw-semibold">@b.CurrentQty</td>
                                        <td>@b.Status</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg></div>
                        <p>暂无批次明细</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a class="btn btn-outline-secondary" asp-action="Index">返回列表</a>
</div>
