@model ShipmentRequest
@{
    ViewData["Title"] = "创建冷链发货";
    ViewData["BackController"] = "ColdChainLogistics";
    ViewData["BackAction"] = "Shipments";
    ViewData["BackText"] = "返回发货记录";
}

<h3>📮 创建冷链发货</h3>
<p class="text-muted">按 FEFO（最早过期优先）扣减批次库存，自动记录批次溯源</p>

<div class="col-md-6">
    <form asp-action="CreateShipment" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <div class="mb-3">
            <label class="form-label">订单 ID</label>
            <input asp-for="OrderID" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">供应商 ID</label>
            <input asp-for="SupplierID" class="form-control" required />
        </div>

        <h6 class="mt-3">商品明细</h6>
        <div id="itemContainer">
            <div class="row g-2 mb-2 item-row">
                <div class="col-6">
                    <input name="Items[0].ProductID" class="form-control" placeholder="产品ID" required />
                </div>
                <div class="col-4">
                    <input name="Items[0].Quantity" class="form-control" type="number" placeholder="数量" required />
                </div>
                <div class="col-2">
                    <button type="button" class="btn btn-danger btn-sm remove-row">×</button>
                </div>
            </div>
        </div>
        <button type="button" class="btn btn-outline-primary btn-sm mb-3" id="addRow">+ 添加商品</button>

        <div>
            <button type="submit" class="btn btn-success">确认发货</button>
            <a class="btn btn-outline-secondary" asp-action="Shipments">取消</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
    let idx = 1;
    document.getElementById('addRow').addEventListener('click', function() {
        var html = `<div class="row g-2 mb-2 item-row">
            <div class="col-6"><input name="Items[${idx}].ProductID" class="form-control" placeholder="产品ID" required /></div>
            <div class="col-4"><input name="Items[${idx}].Quantity" class="form-control" type="number" placeholder="数量" required /></div>
            <div class="col-2"><button type="button" class="btn btn-danger btn-sm remove-row">×</button></div>
        </div>`;
        document.getElementById('itemContainer').insertAdjacentHTML('beforeend', html);
        idx++;
    });
    document.getElementById('itemContainer').addEventListener('click', function(e) {
        if (e.target.classList.contains('remove-row')) {
            e.target.closest('.item-row').remove();
        }
    });
</script>
}
