@{
    ViewData["Title"] = "精准溯源查询";
    ViewData["BackController"] = "SuppliersHome";
    ViewData["BackAction"] = "Index";
    ViewData["BackText"] = "返回供应商首页";

    var orderOptions = ViewBag.OrderOptions as List<OptionItemDto> ?? new List<OptionItemDto>();
    var deliveryOptions = ViewBag.DeliveryOptions as List<OptionItemDto> ?? new List<OptionItemDto>();
    var batchOptions = ViewBag.BatchOptions as List<OptionItemDto> ?? new List<OptionItemDto>();
}

<h3>🔍 精准溯源查询</h3>
<p class="text-muted">支持按订单、发货单、批次多维度追溯冷链商品流向</p>

@if (!string.IsNullOrWhiteSpace(ViewBag.Error))
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="row mb-4">
    <!-- 按订单查询 -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header fw-bold">📋 按订单查询</div>
            <div class="card-body">
                <form asp-action="TraceByOrder" method="get">
                    <div class="mb-2">
                        <select name="orderId" class="form-select" required>
                            <option value="">— 请选择订单 —</option>
                            @foreach (var o in orderOptions)
                            {
                                <option value="@o.Value" selected="@(ViewBag.QueryType == "order" && ViewBag.QueryKey == o.Value)">@o.Text</option>
                            }
                        </select>
                        @if (orderOptions.Count == 0)
                        {
                            <div class="alert alert-warning py-1 small mt-1 mb-0">暂无已发货订单，请先在"发货管理"创建发货单</div>
                        }
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">查询溯源链路</button>
                </form>
            </div>
        </div>
    </div>

    <!-- 按发货单查询 -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header fw-bold">📦 按发货单查询</div>
            <div class="card-body">
                <form asp-action="TraceByDelivery" method="get">
                    <div class="mb-2">
                        <select name="deliveryId" class="form-select" required>
                            <option value="">— 请选择发货单 —</option>
                            @foreach (var d in deliveryOptions)
                            {
                                <option value="@d.Value" selected="@(ViewBag.QueryType == "delivery" && ViewBag.QueryKey == d.Value)">@d.Text</option>
                            }
                        </select>
                        @if (deliveryOptions.Count == 0)
                        {
                            <div class="alert alert-warning py-1 small mt-1 mb-0">暂无发货单，请先在"发货管理"创建发货单</div>
                        }
                    </div>
                    <button type="submit" class="btn btn-success btn-sm">查询批次明细</button>
                </form>
            </div>
        </div>
    </div>

    <!-- 按批次反向溯源 -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header fw-bold">🔬 按批次反向溯源</div>
            <div class="card-body">
                <form asp-action="TraceByBatch" method="get">
                    <div class="mb-2">
                        <select name="batchId" class="form-select" required>
                            <option value="">— 请选择批次 —</option>
                            @foreach (var b in batchOptions)
                            {
                                <option value="@b.Value" selected="@(ViewBag.QueryType == "batch" && ViewBag.QueryKey == b.Value)">@b.Text</option>
                            }
                        </select>
                        @if (batchOptions.Count == 0)
                        {
                            <div class="alert alert-warning py-1 small mt-1 mb-0">暂无库存批次，请先入库</div>
                        }
                    </div>
                    <button type="submit" class="btn btn-warning btn-sm">查询批次去向</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- 正向溯源结果：订单 / 发货单 -->
@if (ViewBag.TraceResult is List<DeliveryTraceDto> traces)
{
    <h5 class="mt-3">
        @(ViewBag.QueryType == "order" ? $"订单" : "发货单") <code>@ViewBag.QueryKey</code> 的溯源结果
    </h5>

    @foreach (var trace in traces)
    {
        <div class="card mb-3 border-info">
            <div class="card-header bg-info text-white d-flex justify-content-between">
                <span>📮 发货单：@trace.TrackingNo</span>
                <span>状态：@trace.LogisticsStatus | @trace.ShippedAt.ToString("yyyy-MM-dd HH:mm")</span>
            </div>
            <div class="card-body">
                <p><strong>DeliveryID：</strong>@trace.DeliveryID | <strong>SupplierID：</strong>@trace.SupplierID</p>
                <h6>批次扣减明细（@trace.Allocations.Count 条）：</h6>
                <table class="table table-sm table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>产品名称</th><th>批次号</th><th>批次过期日</th><th>扣减数量</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in trace.Allocations)
                        {
                            <tr>
                                <td>@a.ProductName</td>
                                <td>@a.BatchNo</td>
                                <td>@(a.ExpiryDate?.ToString("yyyy-MM-dd") ?? "无")</td>
                                <td>@a.Quantity</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<!-- 反向溯源结果：批次 -->
@if (ViewBag.BatchTrace is BatchTraceDto batchTrace)
{
    <h5 class="mt-3">
        批次 <code>@ViewBag.QueryKey</code> 的去向
    </h5>
    <div class="card mb-3 border-warning">
        <div class="card-header bg-warning">
            <span>🔬 批次号：<strong>@batchTrace.BatchNo</strong></span>
            <span class="ms-3">产品：@batchTrace.ProductName</span>
            <span class="ms-3">过期日：@(batchTrace.ExpiryDate?.ToString("yyyy-MM-dd") ?? "无")</span>
        </div>
        <div class="card-body">
            <h6>被以下发货单使用（@batchTrace.Allocations.Count 条）：</h6>
            <table class="table table-sm table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>发货单 ID</th><th>运单号</th><th>产品名称</th><th>发货数量</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in batchTrace.Allocations)
                    {
                        <tr>
                            <td><code>@a.DeliveryID[..8]</code></td>
                            <td>@a.TrackingNo</td>
                            <td>@a.ProductName</td>
                            <td>@a.Quantity</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
