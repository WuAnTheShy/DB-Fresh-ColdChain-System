@model FreightQuoteRequest
@{
    ViewData["Title"] = "冷链运费报价";
}

<h3>💰 冷链运费报价</h3>

<div class="row">
    <!-- 报价表单 -->
    <div class="col-md-5">
        <div class="card">
            <div class="card-header fw-bold">输入订单信息</div>
            <div class="card-body">
                <form asp-action="Quote" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                    <div class="mb-2">
                        <label class="form-label">目的省份</label>
                        <input asp-for="Province" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">目的城市</label>
                        <input asp-for="City" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">目的区县</label>
                        <input asp-for="District" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">商品金额 <small class="text-muted">（根据明细自动计算）</small></label>
                        <input asp-for="GoodsAmount" class="form-control" type="number" step="0.01" readonly />
                    </div>

                    <h6 class="mt-3">商品明细</h6>
                    <div id="itemContainer">
                        @if (Model.Items.Count == 0)
                        {
                            <div class="row g-2 mb-2 item-row">
                                <div class="col-6">
                                    <input name="Items[0].ProductID" class="form-control" placeholder="产品ID" required />
                                </div>
                                <div class="col-4">
                                    <input name="Items[0].Quantity" class="form-control" type="number" placeholder="数量" required />
                                </div>
                                <div class="col-2">
                                    <button type="button" class="btn btn-danger btn-sm remove-row">×</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            for (int i = 0; i < Model.Items.Count; i++)
                            {
                                <div class="row g-2 mb-2 item-row">
                                    <div class="col-6">
                                        <input name="Items[@i].ProductID" class="form-control" placeholder="产品ID" value="@Model.Items[i].ProductID" required />
                                    </div>
                                    <div class="col-4">
                                        <input name="Items[@i].Quantity" class="form-control" type="number" placeholder="数量" value="@Model.Items[i].Quantity" required />
                                    </div>
                                    <div class="col-2">
                                        <button type="button" class="btn btn-danger btn-sm remove-row">×</button>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                    <button type="button" class="btn btn-outline-primary btn-sm mb-3" id="addRow">+ 添加商品</button>

                    <div>
                        <button type="submit" class="btn btn-primary">计算运费</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- 报价结果 -->
    <div class="col-md-7">
        @if (ViewBag.QuoteResult is FreightQuoteDto result)
        {
            <div class="card border-success">
                <div class="card-header bg-success text-white fw-bold">报价结果</div>
                <div class="card-body">
                    <h3 class="text-success">¥@result.FreightAmount.ToString("F2")</h3>
                    <p class="text-muted">@result.RuleSummary</p>
                    @if (result.Items.Count > 0)
                    {
                        <hr />
                        <h6>📦 商品明细</h6>
                        <table class="table table-sm table-bordered">
                            <thead class="table-light">
                                <tr><th>商品名称</th><th>数量</th><th>单价</th><th>小计</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var qi in result.Items)
                                {
                                    <tr>
                                        <td>@qi.ProductName <small class="text-muted">(@qi.ProductID[..8])</small></td>
                                        <td>@qi.Quantity</td>
                                        <td>¥@qi.UnitPrice.ToString("F2")</td>
                                        <td>¥@qi.SubTotal.ToString("F2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="card bg-light">
                <div class="card-body text-center text-muted py-5">
                    <h5>📦</h5>
                    <p>填写左侧表单并点击"计算运费"</p>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    let idx = @(Model.Items.Count > 0 ? Model.Items.Count : 1);
    document.getElementById('addRow').addEventListener('click', function() {
        var html = `<div class="row g-2 mb-2 item-row">
            <div class="col-6"><input name="Items[${idx}].ProductID" class="form-control" placeholder="产品ID" required /></div>
            <div class="col-4"><input name="Items[${idx}].Quantity" class="form-control" type="number" placeholder="数量" required /></div>
            <div class="col-2"><button type="button" class="btn btn-danger btn-sm remove-row">×</button></div>
        </div>`;
        document.getElementById('itemContainer').insertAdjacentHTML('beforeend', html);
        idx++;
    });
    document.getElementById('itemContainer').addEventListener('click', function(e) {
        if (e.target.classList.contains('remove-row')) {
            e.target.closest('.item-row').remove();
        }
    });
</script>
}
