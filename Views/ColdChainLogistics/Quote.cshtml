@model FreightQuoteRequest
@{
    ViewData["Title"] = "冷链运费报价";
    ViewData["BackController"] = "SuppliersHome";
    ViewData["BackAction"] = "Index";
    ViewData["BackText"] = "返回供应商首页";

    var productOptions = ViewBag.ProductOptions as List<OptionItemDto> ?? new List<OptionItemDto>();
    var supplierOptions = ViewBag.SupplierOptions as List<OptionItemDto> ?? new List<OptionItemDto>();
    var provinceOptions = ViewBag.ProvinceOptions as List<string> ?? new List<string>();
    var hasWildcard = (bool)(ViewBag.HasWildcardProvince ?? false);
    var isAdmin = (bool)(ViewBag.IsAdmin ?? false);
}

<h3>💰 冷链运费报价</h3>

<div class="row">
    <!-- 报价表单 -->
    <div class="col-md-5">
        <div class="card">
            <div class="card-header fw-bold">输入订单信息</div>
            <div class="card-body">
                <form asp-action="Quote" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                    <div class="mb-2">
                        <label class="form-label">目的省份</label>
                        <select name="Province" class="form-select" required>
                            <option value="">— 请选择省份 —</option>
                            @foreach (var p in provinceOptions)
                            {
                                <option value="@p" selected="@(Model.Province == p)">@p</option>
                            }
                            @if (!provinceOptions.Contains(Model.Province) && !string.IsNullOrEmpty(Model.Province) && Model.Province != "*")
                            {
                                <option value="@Model.Province" selected>@Model.Province</option>
                            }
                            @if (hasWildcard)
                            {
                                <option value="*" selected="@(Model.Province == "*")">全国（不限省份）</option>
                            }
                        </select>
                        <input name="provinceText" class="form-control mt-1" placeholder="其他省份（手动输入，优先于下拉）" value="@ViewBag.ProvinceCustom" />
                        @if (provinceOptions.Count == 0 && !hasWildcard)
                        {
                            <div class="alert alert-warning py-1 small mt-1 mb-0">暂无启用的运费模板，请先联系管理员在"运费模板管理"配置</div>
                        }
                    </div>
                    <div class="mb-2">
                        <label class="form-label">目的城市</label>
                        <input asp-for="City" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">目的区县</label>
                        <input asp-for="District" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">供应商 <small class="text-muted">（普通供应商固定为自己，管理员可指定）</small></label>
                        @if (isAdmin)
                        {
                            <select asp-for="SupplierID" class="form-select" required>
                                <option value="">— 请选择供应商 —</option>
                                @foreach (var s in supplierOptions)
                                {
                                    <option value="@s.Value" selected="@(Model.SupplierID == s.Value)">@s.Text</option>
                                }
                            </select>
                            @if (supplierOptions.Count == 0)
                            {
                                <div class="alert alert-warning py-1 small mt-1 mb-0">暂无供应商数据</div>
                            }
                        }
                        else
                        {
                            <input asp-for="SupplierID" class="form-control" readonly />
                        }
                    </div>
                    <div class="mb-2">
                        <label class="form-label">商品金额 <small class="text-muted">（根据货物售价自动计算）</small></label>
                        <input asp-for="GoodsAmount" class="form-control" type="number" step="0.01" readonly />
                    </div>

                    <h6 class="mt-3">商品明细</h6>
                    @if (productOptions.Count == 0)
                    {
                        <div class="alert alert-warning py-1 small mb-2">暂无商品数据，请先在商品管理添加商品</div>
                    }
                    <div id="itemContainer">
                        @if (Model.Items.Count == 0)
                        {
                            <div class="row g-2 mb-2 item-row">
                                <div class="col-6">
                                    <select name="Items[0].ProductID" class="form-select" required>
                                        <option value="">— 请选择商品 —</option>
                                        @foreach (var p in productOptions)
                                        {
                                            <option value="@p.Value">@p.Text</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-4">
                                    <input name="Items[0].Quantity" class="form-control" type="number" placeholder="数量" required />
                                </div>
                                <div class="col-2">
                                    <button type="button" class="btn btn-danger btn-sm remove-row">×</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            for (int i = 0; i < Model.Items.Count; i++)
                            {
                                <div class="row g-2 mb-2 item-row">
                                    <div class="col-6">
                                        <select name="Items[@i].ProductID" class="form-select" required>
                                            <option value="">— 请选择商品 —</option>
                                            @foreach (var p in productOptions)
                                            {
                                                <option value="@p.Value" selected="@(Model.Items[i].ProductID == p.Value)">@p.Text</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-4">
                                        <input name="Items[@i].Quantity" class="form-control" type="number" placeholder="数量" value="@Model.Items[i].Quantity" required />
                                    </div>
                                    <div class="col-2">
                                        <button type="button" class="btn btn-danger btn-sm remove-row">×</button>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                    <button type="button" class="btn btn-outline-primary btn-sm mb-3" id="addRow">+ 添加商品</button>

                    <div>
                        <button type="submit" class="btn btn-primary">计算运费</button>
                    </div>
                </form>

                <template id="productRowTemplate">
                    <div class="row g-2 mb-2 item-row">
                        <div class="col-6">
                            <select name="Items[IDX].ProductID" class="form-select" required>
                                <option value="">— 请选择商品 —</option>
                                @foreach (var p in productOptions)
                                {
                                    <option value="@p.Value">@p.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-4">
                            <input name="Items[IDX].Quantity" class="form-control" type="number" placeholder="数量" required />
                        </div>
                        <div class="col-2">
                            <button type="button" class="btn btn-danger btn-sm remove-row">×</button>
                        </div>
                    </div>
                </template>
            </div>
        </div>
    </div>

    <!-- 报价结果 -->
    <div class="col-md-7">
        @if (ViewBag.QuoteResult is FreightQuoteDto result)
        {
            <div class="card border-success">
                <div class="card-header bg-success text-white fw-bold">报价结果</div>
                <div class="card-body">
                    <h3 class="text-success">¥@result.FreightAmount.ToString("F2")</h3>
                    <p class="text-muted">@result.RuleSummary</p>
                    @if (result.Items.Count > 0)
                    {
                        <hr />
                        <h6>📦 商品明细</h6>
                        <table class="table table-sm table-bordered">
                            <thead class="table-light">
                                <tr><th>商品名称</th><th>数量</th><th>单价</th><th>小计</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var qi in result.Items)
                                {
                                    <tr>
                                        <td>@qi.ProductName <small class="text-muted">(@qi.ProductID)</small></td>
                                        <td>@qi.Quantity</td>
                                        <td>¥@qi.UnitPrice.ToString("F2")</td>
                                        <td>¥@qi.SubTotal.ToString("F2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="card bg-light">
                <div class="card-body text-center text-muted py-5">
                    <h5>📦</h5>
                    <p>填写左侧表单并点击"计算运费"</p>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    let idx = @(Model.Items.Count > 0 ? Model.Items.Count : 1);
    document.getElementById('addRow').addEventListener('click', function() {
        var tpl = document.getElementById('productRowTemplate');
        var node = tpl.content.firstElementChild.cloneNode(true);
        node.querySelectorAll('[name]').forEach(function(el) { el.name = el.name.replace('IDX', idx); });
        document.getElementById('itemContainer').appendChild(node);
        idx++;
    });
    document.getElementById('itemContainer').addEventListener('click', function(e) {
        if (e.target.classList.contains('remove-row')) {
            e.target.closest('.item-row').remove();
        }
    });
</script>
}
