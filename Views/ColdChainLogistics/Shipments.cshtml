@model List<LogExpressDelivery>
@{
    ViewData["Title"] = "冷链发货记录";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>📮 冷链发货记录</h3>
    <a class="btn btn-success" asp-action="CreateShipment">创建发货</a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>发货编号</th><th>订单号</th><th>供应商</th>
            <th>运单号</th><th>温区</th><th>状态</th><th>发货时间</th>
        </tr>
    </thead>
    <tbody>
    @if (Model.Any())
    {
        @foreach (var d in Model)
        {
            <tr>
                <td>@d.DeliveryID[..8]</td>
                <td>@d.OrderID[..8]</td>
                <td>@d.SupplierID[..8]</td>
                <td>@d.TrackingNo</td>
                <td>@d.PackageTemp</td>
                <td>@d.LogisticsStatus</td>
                <td>@d.ShippedAt.ToString("yyyy-MM-dd HH:mm")</td>
            </tr>
        }
    }
    else
    {
        <tr><td colspan="7" class="text-center">暂无发货记录</td></tr>
    }
    </tbody>
</table>
