@model List<LogExpressDelivery>
@{
    ViewData["Title"] = "冷链发货记录";
    ViewData["BackController"] = "SuppliersHome";
    ViewData["BackAction"] = "Index";
    ViewData["BackText"] = "返回供应商首页";
}

<div class="page-hero">
    <div>
        <div class="hero-greeting">冷链发货记录</div>
        <div class="hero-meta">
            <span class="text-white-50">按 FEFO（最早过期优先）扣减批次库存，自动记录批次溯源</span>
        </div>
    </div>
    <div class="hero-actions">
        <a class="btn btn-light btn-sm" asp-action="CreateShipment">创建发货</a>
    </div>
</div>

<div class="content-card">
    <div class="content-card-header">
        <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7h11v9H2z"/><path d="M13 10h4l3 3v3h-7z"/><circle cx="6" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg> 发货清单</h5>
        <span class="text-muted small">共 @Model.Count 单</span>
    </div>
    <div class="content-card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>发货编号</th><th>订单号</th><th>供应商</th>
                            <th>运单号</th><th>温区</th><th>状态</th><th>发货时间</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model)
                        {
                            <tr>
                                <td><code class="order-id">@d.DeliveryID[..8]</code></td>
                                <td><code class="order-id">@d.OrderID[..8]</code></td>
                                <td><code class="order-id">@d.SupplierID[..8]</code></td>
                                <td>@d.TrackingNo</td>
                                <td>@d.PackageTemp</td>
                                <td>@d.LogisticsStatus</td>
                                <td class="small text-muted">@d.ShippedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8h2a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H8"/><path d="M4 6h9a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-2"/><circle cx="7" cy="17" r="3"/><path d="M3 6V4a1 1 0 0 1 1-1h4"/></svg></div>
                <p>暂无发货记录，点右上角「创建发货」登记第一单。</p>
            </div>
        }
    </div>
</div>
