@model LogFreightTemplate
@{
    ViewData["Title"] = "新增运费模板";
    ViewData["BackController"] = "ColdChainLogistics";
    ViewData["BackAction"] = "Index";
    ViewData["BackText"] = "返回运费模板";
}

<div class="page-hero">
    <div>
        <div class="hero-greeting">新增冷链运费模板</div>
        <div class="hero-meta">
            <span class="text-white-50">省份/城市/区县填 * 表示通配（* 全国、* 全省、* 全市）</span>
        </div>
    </div>
</div>

<div class="content-card">
    <div class="content-card-header">
        <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h3l2 4h10l-2 6H7l-3-10z"/><path d="M6 4h13l1 6H9"/></svg> 模板信息</h5>
    </div>
    <div class="content-card-body">
        <div class="row">
            <div class="col-lg-7">
                <form asp-action="CreateTemplate" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label">模板名称</label>
                        <input asp-for="TemplateName" class="form-control" required />
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">省份（* 表示全国）</label>
                            <input asp-for="DestinationProvince" class="form-control" value="*" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">城市（* 表示全省）</label>
                            <input asp-for="DestinationCity" class="form-control" value="*" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">区县（* 表示全市）</label>
                            <input asp-for="DestinationDistrict" class="form-control" value="*" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">温区</label>
                        <select asp-for="TemperatureZone" class="form-select">
                            <option value="CHILLED">冷藏 (CHILLED)</option>
                            <option value="FROZEN">冷冻 (FROZEN)</option>
                            <option value="AMBIENT">常温 (AMBIENT)</option>
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">首重 (kg)</label>
                            <input asp-for="BaseWeight" class="form-control" type="number" step="0.1" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">首重费用</label>
                            <input asp-for="BaseFee" class="form-control" type="number" step="0.01" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">续重单位 (kg)</label>
                            <input asp-for="ExtraWeightUnit" class="form-control" type="number" step="0.1" value="1" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">续重单价</label>
                            <input asp-for="ExtraWeightFee" class="form-control" type="number" step="0.01" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">冷链包装费</label>
                            <input asp-for="PackagingFee" class="form-control" type="number" step="0.01" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">包邮阈值 (留空=无)</label>
                            <input asp-for="FreeShippingThreshold" class="form-control" type="number" step="0.01" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success">创建模板</button>
                    <a class="btn btn-outline-secondary" asp-action="Index">取消</a>
                </form>
            </div>
        </div>
    </div>
</div>
