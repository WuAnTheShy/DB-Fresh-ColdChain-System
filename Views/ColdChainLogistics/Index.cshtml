@model List<LogFreightTemplate>
@{
    ViewData["Title"] = "运费模板管理";
    ViewData["BackController"] = "SuppliersHome";
    ViewData["BackAction"] = "Index";
    ViewData["BackText"] = "返回供应商首页";
}

<div class="page-hero">
    <div>
        <div class="hero-greeting">冷链运费模板</div>
        <div class="hero-meta">
            <span class="text-white-50">按目的省市区与温区配置首重、续重、包装费与包邮阈值；省份/城市/区县填 * 表示通配</span>
        </div>
    </div>
    <div class="hero-actions">
        <a class="btn btn-light btn-sm" asp-action="CreateTemplate">新增模板</a>
    </div>
</div>

<div class="content-card">
    <div class="content-card-header">
        <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> 模板清单</h5>
        <span class="text-muted small">共 @Model.Count 个</span>
    </div>
    <div class="content-card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>模板名称</th><th>省份</th><th>城市</th><th>温区</th>
                            <th>首重(kg)</th><th>首费</th><th>续重单价</th><th>包装费</th><th>包邮阈值</th><th>状态</th><th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@t.TemplateName</td>
                                <td>@t.DestinationProvince</td>
                                <td>@t.DestinationCity</td>
                                <td>@t.TemperatureZone</td>
                                <td>@t.BaseWeight</td>
                                <td>¥@t.BaseFee.ToString("F2")</td>
                                <td>¥@t.ExtraWeightFee/kg</td>
                                <td>¥@t.PackagingFee</td>
                                <td>@(t.FreeShippingThreshold?.ToString("F2") ?? "无")</td>
                                <td>
                                    @if (t.IsEnabled == 1)
                                    {
                                        <span class="badge bg-success">启用</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">禁用</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a class="btn btn-sm btn-outline-primary" asp-action="EditTemplate" asp-route-id="@t.TemplateID">编辑</a>
                                        <form asp-action="DeleteTemplate" asp-route-id="@t.TemplateID" method="post" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('确定删除？')">删除</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h3l2 4h10l-2 6H7l-3-10z"/><path d="M6 4h13l1 6H9"/></svg></div>
                <p>暂无运费模板，点右上角「新增模板」创建第一个模板。</p>
            </div>
        }
    </div>
</div>
