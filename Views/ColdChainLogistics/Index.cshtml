@model List<LogFreightTemplate>
@{
    ViewData["Title"] = "运费模板管理";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>🚚 冷链运费模板</h3>
    <a class="btn btn-success" asp-action="CreateTemplate">新增模板</a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>模板名称</th><th>省份</th><th>城市</th><th>温区</th>
            <th>首重(kg)</th><th>首费</th><th>续重单价</th><th>包装费</th><th>包邮阈值</th><th>操作</th>
        </tr>
    </thead>
    <tbody>
    @if (Model.Any())
    {
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.TemplateName</td>
                <td>@t.DestinationProvince</td>
                <td>@t.DestinationCity</td>
                <td>@t.TemperatureZone</td>
                <td>@t.BaseWeight</td>
                <td>¥@t.BaseFee.ToString("F2")</td>
                <td>¥@t.ExtraWeightFee/kg</td>
                <td>¥@t.PackagingFee</td>
                <td>@(t.FreeShippingThreshold?.ToString("F2") ?? "无")</td>
                <td>
                    <form asp-action="DeleteTemplate" asp-route-id="@t.TemplateID" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('确定删除？')">删除</button>
                    </form>
                </td>
            </tr>
        }
    }
    else
    {
        <tr><td colspan="10" class="text-center">暂无运费模板</td></tr>
    }
    </tbody>
</table>
