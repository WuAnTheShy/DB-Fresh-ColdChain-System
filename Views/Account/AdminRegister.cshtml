@{
    ViewData["Title"] = "管理员注册";
    var kinds = ViewBag.AdminKinds as (string Code, string Name)[] ?? new (string Code, string Name)[0];
}
<link rel="stylesheet" href="~/css/accountsite.css" asp-append-version="true" />

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="selection1 p-4">
                <div class="selection2 mb-3" style="padding: 1.5rem; text-align: center;">
                    <h3 style="font-size: 1.8rem; color: white;">管理员注册</h3>
                    <div style="font-size: 0.9rem; opacity: 0.9; color: white;">提交后需等待「账号管理员」审核通过方可登录</div>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert" data-auto-dismiss>
                        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form asp-action="AdminRegister" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">真实姓名</label>
                        <input type="text" class="form-control" name="realname" placeholder="请输入真实姓名" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">所属管理员种类 <span class="text-danger">*</span></label>
                        <select name="adminKind" class="form-select" required>
                            <option value="">请选择管理员种类</option>
                            @foreach (var kind in kinds)
                            {
                                <option value="@kind.Code">@kind.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">联系电话</label>
                        <input type="text" class="form-control" name="phonenumber" placeholder="请输入联系电话号码" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">用户名</label>
                        <input type="text" class="form-control" name="username" placeholder="请输入用户名" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">密码</label>
                        <input type="password" class="form-control" name="password" placeholder="请输入密码" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">确认密码</label>
                        <input type="password" class="form-control" name="password_again" placeholder="请再次输入密码" required />
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-lg button1 text-white">提交注册</button>
                    </div>
                </form>

                <div class="text-center mt-4">
                    <a class="back-btn" asp-action="Login" asp-controller="Account" asp-route-role="管理员">返回登录</a>
                </div>
            </div>
        </div>
    </div>
</div>
