@* Views/Account/Login.cshtml *@
@{
    ViewData["Title"] = $"{@ViewBag.Role} 登录";
}

<link rel="stylesheet" href="~/css/accountsite.css" asp-append-version="true" />

<div class="container" style="margin-top: 4.5rem;">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <!-- 改用 selection1 卡片 -->
            <div class="selection1 p-4">
                <!-- 标题区：可以使用 selection2 风格，也可自定义 -->
                <div class="selection2 mb-3" style="padding: 1.5rem; text-align: center;">
                    <h3 style="font-size: 1.8rem; color: white;">登 录</h3>
                    <div style="font-size: 0.9rem; opacity: 0.9; color: white;">正在以 @ViewBag.Role 身份登录</div>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert" data-auto-dismiss>
                        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form asp-action="Login" asp-route-role="@ViewBag.Role" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">用户名</label>
                        <input type="text" class="form-control" id="username" name="username"
                               placeholder="请输入用户名" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">密码</label>
                        <input type="password" class="form-control" id="password" name="password"
                               placeholder="请输入密码" required />
                    </div>

                    <div class="mb-4 text-center">
                        <span class="text-muted small">没有账号？</span>
                        <a asp-action="Register" asp-controller="Account" asp-route-role="@ViewBag.Role" class="fw-bold text-primary">
                            点击注册新账户
                        </a>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-lg button1 text-white">登 录</button>
                    </div>
                </form>

                <div class="text-center mt-4">
                    <a class="back-btn" asp-action="RoleSelect" asp-controller="Account">返回身份选择</a>
                </div>
            </div>
        </div>
    </div>
</div>
