@{
    ViewData["Title"] = "角色选择";
}

<link rel="stylesheet" href="~/css/accountsite.css" asp-append-version="true" />

<div class="container" style="margin-top: 4.5rem;">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="selection1 p-4 p-lg-5 text-center">
                <!-- 卡片内部放一个小横幅，模拟首页 -->
                <div class="selection2 mb-4" style="padding: 2rem;">
                    <h3 class="fw-bold text-white" style="font-size: 2rem;">选择您的身份</h3>
                    <p class="fw-bold text-white" style="font-size: 1rem;">请选择您的身份以进入对应子系统</p>
                </div>

                <div class="d-grid gap-3">
                    <a class="btn btn-primary btn-lg button1"  asp-controller="Account" asp-action="Login" asp-route-role="团长">
                        团长登入
                    </a>
                    <a class="btn btn-primary btn-lg button1" asp-controller="Account" asp-action="Login" asp-route-role="供应商">
                        供应商登入
                    </a>
                    <a class="btn btn-primary btn-lg button2" asp-controller="Account" asp-action="Login" asp-route-role="管理员">
                        管理员登入
                    </a>
                </div>

                <div class="text-center mt-4">
                    <a class="back-btn" asp-controller="Home" asp-action="Index">返回首页</a>
                </div>
            </div>
        </div>
    </div>
</div>
