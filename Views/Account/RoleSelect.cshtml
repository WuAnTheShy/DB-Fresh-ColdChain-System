@{
    ViewData["Title"] = "角色选择";
}
<h1>@ViewData["Title"]</h1>
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="card-title text-center mb-4">选择您的身份</h3>
                    <div class="d-grid gap-3">
                        <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Login" asp-route-role="团长">团长登入</a>
                        <a class="btn btn-outline-success" asp-controller="Promoter" asp-action="Demo">团长工作台预览（演示数据）</a>
                        <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Login" asp-route-role="消费者">消费者登入</a>
                        <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Login" asp-route-role="供应商">供应商登入</a>
                        <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Login" asp-route-role="管理员">管理员登入</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

