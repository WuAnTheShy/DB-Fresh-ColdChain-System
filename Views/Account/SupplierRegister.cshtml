@* Views/Account/SupplierRegister.cshtml *@
@{
    ViewData["Title"] = "供应商 注册";
}
<link rel="stylesheet" href="~/css/accountsite.css" asp-append-version="true" />

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="selection1 p-4">
                <div class="selection2 mb-3" style="padding: 1.5rem; text-align: center;">
                    <h3 style="font-size: 1.8rem; color: white;"> 注 册</h3>
                    <div style="font-size: 0.9rem; opacity: 0.9; color: white;">正在以 @ViewBag.Role 身份入驻</div>
                </div>
                @* 显示全局错误信息 *@
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger" role="alert" data-auto-dismiss>
                        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                    </div>
                }

                <form asp-action="SupplierRegister" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label for="suppliername" class="form-label">供应商名称</label>
                        <input type="text" class="form-control" id="suppliername" name="suppliername"
                               placeholder="请输入供应商名称" required />
                    </div>

                    <div class="mb-3">
                        <label for="licenseno" class="form-label">资质编号</label>
                        <input type="text" class="form-control" id="licenseno" name="licenseno"
                               placeholder="请输入营业执照 / 资质编号" />
                    </div>

                    <div class="mb-3">
                        <label for="expirydate" class="form-label">资质到期时间</label>
                        <input type="date" class="form-control" id="expirydate" name="expirydate" />
                    </div>

                    <div class="mb-3">
                        <label for="contactphone" class="form-label">联系电话</label>
                        <input type="text" class="form-control" id="contactphone" name="contactphone"
                               placeholder="请输入联系电话" />
                    </div>

                    <div class="mb-3">
                        <label for="username" class="form-label">登录账号</label>
                        <input type="text" class="form-control" id="username" name="username"
                               placeholder="请输入登录账号" required />
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">密码</label>
                        <input type="password" class="form-control" id="password" name="password"
                               placeholder="请输入密码" required />
                    </div>

                    <div class="mb-3">
                        <label for="password_again" class="form-label">确认密码</label>
                        <input type="password" class="form-control" id="password_again" name="password_again"
                               placeholder="请再次输入密码" required />
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-lg button1 text-white">提交入驻申请</button>
                    </div>
                </form>

                <div class="text-center mt-4">
                    <a class="back-btn" asp-action="Login" asp-controller="Account" asp-route-role="供应商">返回登录</a>
                </div>
            </div>
        </div>
    </div>
</div>
