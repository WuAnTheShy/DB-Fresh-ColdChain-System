@model GroupLeaderDto
@{
    ViewData["Title"] = $"团长详情 — {Model.Name}";
}
<h3>👤 @Model.Name</h3>
<table class="table table-bordered w-50">
    <tr><th style="width:100px">ID</th><td>@Model.Id</td></tr>
    <tr><th>姓名</th><td>@Model.Name</td></tr>
    <tr><th>电话</th><td>@Model.Phone</td></tr>
    <tr><th>社区</th><td>@Model.CommunityName</td></tr>
    <tr><th>地址</th><td>@Model.Address</td></tr>
    <tr><th>状态</th><td>@(Model.Status == 1 ? "启用" : "停用")</td></tr>
    <tr><th>订单数</th><td>@Model.OrderCount</td></tr>
</table>
<a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.Id">编辑</a>
<a class="btn btn-outline-secondary" asp-action="Index">返回</a>
<br/>
<a class="btn btn-outline-primary mt-2" asp-controller="Orders" asp-action="ByLeader" asp-route-leaderId="@Model.Id">查看该团长订单</a>
