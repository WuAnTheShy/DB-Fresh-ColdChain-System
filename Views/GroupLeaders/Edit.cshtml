@model CreateGroupLeaderDto
@{
    ViewData["Title"] = "编辑团长";
}
<h3>编辑团长</h3>
<div class="col-md-6">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3"><label class="form-label">姓名</label><input asp-for="Name" class="form-control" required /></div>
        <div class="mb-3"><label class="form-label">电话</label><input asp-for="Phone" class="form-control" /></div>
        <div class="mb-3"><label class="form-label">社区名称</label><input asp-for="CommunityName" class="form-control" /></div>
        <div class="mb-3"><label class="form-label">地址</label><input asp-for="Address" class="form-control" /></div>
        <button type="submit" class="btn btn-primary">保存</button>
        <a class="btn btn-outline-secondary" asp-action="Index">取消</a>
    </form>
</div>
