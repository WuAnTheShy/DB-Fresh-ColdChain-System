@model PagedResult<GroupLeaderDto>
@{
    ViewData["Title"] = "团长管理";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>👤 团长列表</h3>
    <a class="btn btn-success" asp-action="Create">新增团长</a>
</div>
<table class="table table-striped table-hover">
    <thead class="table-dark"><tr><th>ID</th><th>姓名</th><th>电话</th><th>社区</th><th>订单数</th><th>状态</th><th>操作</th></tr></thead>
    <tbody>
    @if (Model.Items.Any())
    {
        @foreach (var g in Model.Items)
        {
            <tr>
                <td>@g.Id</td><td>@g.Name</td><td>@g.Phone</td><td>@g.CommunityName</td>
                <td>@g.OrderCount</td>
                <td>@(g.Status == 1 ? "✅ 启用" : "❌ 停用")</td>
                <td>
                    <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@g.Id">详情</a>
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@g.Id">编辑</a>
                    <form asp-action="Delete" asp-route-id="@g.Id" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('确定删除？')">删除</button>
                    </form>
                    @if (g.Status == 1)
                    {
                        <form asp-action="Disable" asp-route-id="@g.Id" method="post" style="display:inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-secondary">停用</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Enable" asp-route-id="@g.Id" method="post" style="display:inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-success">启用</button>
                        </form>
                    }
                </td>
            </tr>
        }
    }
    else
    {
        <tr><td colspan="7" class="text-center">暂无数据</td></tr>
    }
    </tbody>
</table>
@await Html.PartialAsync("_Pagination", Model)
