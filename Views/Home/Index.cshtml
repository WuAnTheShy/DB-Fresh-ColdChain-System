@{
    ViewData["Title"] = "首页";
}

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/homesite.css" asp-append-version="true" />
<link rel="stylesheet" href="~/System.styles.css" asp-append-version="true" />
<div class="container py-4">
    <!-- 1. 欢迎横幅 (Hero Banner) -->
    <div class="hero-section">
        <h1>欢迎访问生鲜冷链系统</h1>
        <p>全链路团购分销供应链管理平台 · 高效 · 智能 · 可靠</p>
        <a asp-controller="Account" asp-action="RoleSelect" class="btn btn-light btn-lg">登  录</a>
    </div>

    <!-- 2. 核心功能卡片区 -->
    <div class="row g-4">
        <div class="col-md-6 col-lg-3">
            <div class="feature-card">
                <span class="feature-icon">🧊</span>
                <h5>商品与库存</h5>
                <p>供应商管理、批次 FEFO 先进先出、冷链仓储盘点</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="feature-card">
                <span class="feature-icon">👥</span>
                <h5>团长分销</h5>
                <p>团长入驻、阶梯佣金自动结算、业绩等级可视化</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="feature-card">
                <span class="feature-icon">🛒</span>
                <h5>C端交易</h5>
                <p>购物车下单、优惠券核销、积分与成长体系</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="feature-card">
                <span class="feature-icon">📊</span>
                <h5>财务与风控</h5>
                <p>支付流水、退款逆向结算、操作审计日志防篡改</p>
            </div>
        </div>
    </div>

    <!-- 3. 系统亮点简介 -->
    <div class="info-card">
        <h5>🚀 生鲜冷链团购分销供应链系统</h5>
        <p class="mb-0 text-muted">
            本系统集成“供应商-商品-库存”供应链闭环、“团长-消费者”分销裂变、“订单-物流-财务”履约追踪，实现全链路的数字化管理。上方“立即进入系统”可前往角色选择，体验各端业务流程。
        </p>
    </div>
</div>