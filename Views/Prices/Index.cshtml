@model PagedResult<PriceRuleDto>
@{
    ViewData["Title"] = "定价规则管理";
    ViewData["BackController"] = "SuppliersHome";
    ViewData["BackAction"] = "Index";
    ViewData["BackText"] = "返回供应商首页";
}

<div class="page-hero">
    <div>
        <div class="hero-greeting">定价规则管理</div>
        <div class="hero-meta">
            <span class="text-white-50">为货物配置时段折扣、临期折扣、批量折扣与手动调价；优先级越小越优先，多规则按优先级命中</span>
        </div>
    </div>
    <div class="hero-actions">
        <a asp-action="Create" class="btn btn-light btn-sm">新建规则</a>
        <a asp-action="Calculate" class="btn btn-outline-light btn-sm">实时价格试算</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" data-auto-dismiss>@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" data-auto-dismiss>@TempData["Error"]</div>
}

<div class="content-card">
    <div class="content-card-header">
        <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1"/></svg> 规则清单</h5>
        <span class="text-muted small">共 @(Model?.TotalCount ?? 0) 条</span>
    </div>
    <div class="content-card-body p-0">
        @if (Model?.Items.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>商品</th>
                            <th>规则名称</th>
                            <th>触发类型</th>
                            <th>时段</th>
                            <th>折扣率</th>
                            <th>优先级</th>
                            <th>状态</th>
                            <th>有效期</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@r.ProductName <small class="text-muted">(@r.ProductID[..8])</small></td>
                                <td>@r.RuleName</td>
                                <td>
                                    @switch (r.TriggerType)
                                    {
                                        case "TimeBased":<span class="badge bg-info">时段折扣</span> break;
                                        case "ExpiryApproaching":<span class="badge bg-warning">临期折扣</span> break;
                                        case "BulkDiscount":<span class="badge bg-success">批量折扣</span> break;
                                        case "ManualPrice":<span class="badge bg-secondary">手动调价</span> break;
                                        default:<span class="badge bg-light text-dark">@r.TriggerType</span> break;
                                    }
                                </td>
                                <td>@(r.TimeWindow ?? "全时段")</td>
                                <td>@(r.ManualPrice.HasValue && r.TriggerType == "ManualPrice" ? $"¥{r.ManualPrice}" : r.DiscountRate.HasValue ? $"{r.DiscountRate.Value * 10:0.##}折" : "-")</td>
                                <td>@r.Priority</td>
                                <td>
                                    @if (r.IsActive)
                                    {
                                        <span class="badge bg-success">启用</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">禁用</span>
                                    }
                                </td>
                                <td>
                                    @if (r.EffectiveFrom.HasValue || r.EffectiveTo.HasValue)
                                    {
                                        <small>@(r.EffectiveFrom?.ToString("MM-dd") ?? "∞") ~ @(r.EffectiveTo?.ToString("MM-dd") ?? "∞")</small>
                                    }
                                    else
                                    { <small class="text-muted">长期有效</small> }
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="Edit" asp-route-id="@r.RuleID" class="btn btn-sm btn-outline-primary">编辑</a>
                                        <form asp-action="Delete" method="post" class="d-inline"
                                              onsubmit="return confirm('确认删除该规则？')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@r.RuleID" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">删除</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1"/></svg></div>
                <p>暂无规则，点右上角「新建规则」创建第一条定价规则。</p>
            </div>
        }
    </div>
</div>

@if (Model?.TotalPages > 1)
{
    <partial name="_Pagination" model="Model" />
}
