@model List<GoodsDto>
@{
    ViewData["Title"] = "我的货物";
    ViewData["BackController"] = "SuppliersHome";
    ViewData["BackAction"] = "Index";
    ViewData["BackText"] = "返回供应商首页";
}
@functions {
    static string ZoneText(string? z) => (z ?? "").Trim().ToUpperInvariant() switch
    {
        "CHILLED" => "冷藏",
        "FROZEN" => "冷冻",
        "AMBIENT" => "常温",
        _ => string.IsNullOrWhiteSpace(z) ? "未设置" : z.Trim()
    };
}

<div class="page-hero">
    <div>
        <div class="hero-greeting">我的货物</div>
        <div class="hero-meta">
            <span class="text-white-50">售价即团长进价；支持行内改价、编辑图文、上下架与进货库存</span>
        </div>
    </div>
    <div class="hero-actions">
        <a class="btn btn-light btn-sm" asp-action="Add">对物品建立货物</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" data-auto-dismiss>@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" data-auto-dismiss>@TempData["Error"]</div>
}

<div class="content-card">
    <div class="content-card-header">
        <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg> 货物清单</h5>
        <span class="text-muted small">共 @Model.Count 件</span>
    </div>
    <div class="content-card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>物品</th>
                            <th>分类</th>
                            <th>售价（= 团长进价）</th>
                            <th>温区</th>
                            <th>保质期(小时)</th>
                            <th>状态</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@g.ProductName</td>
                                <td>@g.CategoryName</td>
                                <td>
                                    <form asp-action="Edit" method="post" class="d-flex gap-1 align-items-center">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@g.ProductID" />
                                        <input type="number" step="0.01" name="SalePrice" value="@g.SalePrice" class="form-control form-control-sm" style="width:110px" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary">改价</button>
                                    </form>
                                </td>
                                <td>@ZoneText(g.StorageReq)</td>
                                <td>@(g.ShelfLifeHours.HasValue ? $"{g.ShelfLifeHours.Value} 小时" : "未设置")</td>
                                <td>
                                    @if (g.Status == "ACTIVE")
                                    {
                                        <span class="badge bg-success">上架</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">下架</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-productId="@g.ProductID"
                                           title="编辑售价、温区、保质期与商品图文（文字介绍+图片）">编辑</a>
                                        <a class="btn btn-sm btn-outline-info" asp-controller="Goods" asp-action="StockIn" asp-route-productId="@g.ProductID">进货/库存</a>
                                        <form asp-action="ToggleStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@g.ProductID" />
                                            <input type="hidden" name="status" value="@(g.Status == "ACTIVE" ? "INACTIVE" : "ACTIVE")" />
                                            <button type="submit" class="btn btn-sm @(g.Status == "ACTIVE" ? "btn-outline-warning" : "btn-outline-success")">
                                                @(g.Status == "ACTIVE" ? "下架" : "上架")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg></div>
                <p>你还没有货物，点右上角「对物品建立货物」开始供货。</p>
            </div>
        }
    </div>
</div>
