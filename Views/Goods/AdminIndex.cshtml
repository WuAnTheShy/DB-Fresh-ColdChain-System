@model List<GoodsDto>
@{
    ViewData["Title"] = "全部货物";
    ViewData["BackController"] = "SuppliersHome";
    ViewData["BackAction"] = "Index";
    ViewData["BackText"] = "返回供应商首页";
}

<div class="page-hero">
    <div>
        <div class="hero-greeting">全部货物</div>
        <div class="hero-meta">
            <span class="text-white-50">平台全部供应商的供货货物总览，可整体上下架</span>
        </div>
    </div>
    <div class="hero-actions">
        <a class="btn btn-outline-light btn-sm" asp-controller="Products" asp-action="Index">物品管理</a>
        <a class="btn btn-outline-light btn-sm" asp-controller="Prices" asp-action="Index">定价规则</a>
        <a class="btn btn-outline-light btn-sm" asp-controller="ColdChainLogistics" asp-action="Index">运费模板</a>
        <a class="btn btn-outline-light btn-sm" asp-controller="ColdChainLogistics" asp-action="Shipments">发货管理</a>
    </div>
</div>

<div class="content-card">
    <div class="content-card-header">
        <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg> 货物清单</h5>
        <form method="get" class="d-flex gap-2">
            <input type="text" name="keyword" class="form-control form-control-sm" placeholder="搜索物品/供应商..." value="@ViewBag.Keyword" style="width:220px" />
            <button class="btn btn-sm btn-primary">搜索</button>
            <a class="btn btn-sm btn-outline-secondary" asp-action="AdminIndex">清除</a>
        </form>
    </div>
    <div class="content-card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>物品</th>
                            <th>分类</th>
                            <th>归属供应商</th>
                            <th>售价</th>
                            <th>温区</th>
                            <th>保质期(小时)</th>
                            <th>状态</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@g.ProductName</td>
                                <td>@g.CategoryName</td>
                                <td>@g.SupplierName</td>
                                <td>¥@g.SalePrice.ToString("F2")</td>
                                <td>@g.StorageReq</td>
                                <td>@g.ShelfLifeHours</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (g.Status == "ACTIVE")
                                        {
                                            <span class="badge bg-success">上架</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">下架</span>
                                        }
                                        <form asp-action="AdminToggleStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@g.ProductID" />
                                            <input type="hidden" name="supplierId" value="@g.SupplierID" />
                                            <input type="hidden" name="status" value="@(g.Status == "ACTIVE" ? "INACTIVE" : "ACTIVE")" />
                                            <button type="submit" class="btn btn-sm @(g.Status == "ACTIVE" ? "btn-outline-warning" : "btn-outline-success")">
                                                @(g.Status == "ACTIVE" ? "下架" : "上架")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg></div>
                <p>暂无货物</p>
            </div>
        }
    </div>
</div>
