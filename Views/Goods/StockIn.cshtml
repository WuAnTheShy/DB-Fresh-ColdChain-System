@using FreshColdChain.Models
@{
    ViewData["Title"] = "进货 / 库存";
    ViewData["BackController"] = "Goods";
    ViewData["BackAction"] = "MyGoods";
    ViewData["BackText"] = "返回我的货物";
    var batches = ViewBag.Batches as List<InvStockBatch> ?? new List<InvStockBatch>();
}

<div class="page-hero">
    <div>
        <div class="hero-greeting">进货 / 库存</div>
        <div class="hero-meta">
            <span class="text-white-50">@ViewBag.ProductName</span>
            <span class="text-white-50">· 供应商：@ViewBag.SupplierName（进货自动记到自己名下）</span>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" data-auto-dismiss>@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" data-auto-dismiss>@TempData["Error"]</div>
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="content-card">
            <div class="content-card-header">
                <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v14"/><path d="m7 12 5 5 5-5"/><path d="M5 21h14"/></svg> 进货（入库）</h5>
            </div>
            <div class="content-card-body">
                <form asp-action="StockIn" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@ViewBag.ProductId" />
                    <div class="mb-3">
                        <label class="form-label">数量</label>
                        <input type="number" name="quantity" class="form-control" min="1" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">批次号（留空自动生成）</label>
                        <input type="text" name="batchNo" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">生产日期</label>
                        <input type="date" name="productionDate" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-success">入库</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="content-card">
            <div class="content-card-header">
                <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="6" rx="1"/><rect x="3" y="14" width="18" height="6" rx="1"/></svg> 我的进货批次</h5>
                <span class="text-muted small">共 @batches.Count 批</span>
            </div>
            <div class="content-card-body p-0">
                @if (batches.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>批次号</th>
                                    <th>生产日期</th>
                                    <th>过期日期</th>
                                    <th>进价</th>
                                    <th>初始</th>
                                    <th>当前</th>
                                    <th>状态</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in batches)
                                {
                                    <tr>
                                        <td><code class="order-id">@b.BatchNo</code></td>
                                        <td class="small text-muted">@b.ProductionDate?.ToString("yyyy-MM-dd")</td>
                                        <td class="small text-muted">@b.ExpiryDate?.ToString("yyyy-MM-dd")</td>
                                        <td>¥@b.InPrice.ToString("F2")</td>
                                        <td>@b.InitialQty</td>
                                        <td class="fw-semibold">@b.CurrentQty</td>
                                        <td>@b.Status</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg></div>
                        <p>还没有进货批次</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
