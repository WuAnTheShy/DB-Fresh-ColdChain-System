@using FreshColdChain.Models
@{
    ViewData["Title"] = "进货 / 库存";
    ViewData["BackController"] = "Goods";
    ViewData["BackAction"] = "MyGoods";
    ViewData["BackText"] = "返回我的货物";
    var batches = ViewBag.Batches as List<InvStockBatch> ?? new List<InvStockBatch>();
}
<h3>进货 / 库存 — @ViewBag.ProductName</h3>
<p class="text-muted">供应商：@ViewBag.SupplierName（进货自动记到自己名下）</p>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<div class="row">
    <div class="col-md-5">
        <div class="card mb-3">
            <div class="card-header">进货（入库）</div>
            <div class="card-body">
                <form asp-action="StockIn" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@ViewBag.ProductId" />
                    <div class="mb-3">
                        <label class="form-label">数量</label>
                        <input type="number" name="quantity" class="form-control" min="1" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">批次号（留空自动生成）</label>
                        <input type="text" name="batchNo" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">生产日期</label>
                        <input type="date" name="productionDate" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-success">入库</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card">
            <div class="card-header">我的进货批次</div>
            <div class="card-body table-responsive">
                <table class="table table-striped table-sm">
                    <thead class="table-dark"><tr><th>批次号</th><th>生产日期</th><th>过期日期</th><th>进价</th><th>初始</th><th>当前</th><th>状态</th></tr></thead>
                    <tbody>
                    @if (batches.Any())
                    {
                        @foreach (var b in batches)
                        {
                            <tr>
                                <td>@b.BatchNo</td>
                                <td>@b.ProductionDate?.ToString("yyyy-MM-dd")</td>
                                <td>@b.ExpiryDate?.ToString("yyyy-MM-dd")</td>
                                <td>¥@b.InPrice.ToString("F2")</td>
                                <td>@b.InitialQty</td>
                                <td>@b.CurrentQty</td>
                                <td>@b.Status</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-center text-muted">还没有进货批次</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
