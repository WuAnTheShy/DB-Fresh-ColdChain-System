@model PagedResult<SupplierDto>
@{
    ViewData["Title"] = "供应商管理";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>供应商列表</h3>
    <a class="btn btn-success" asp-action="Create">新增供应商</a>
</div>
<table class="table table-striped table-hover">
    <thead class="table-dark"><tr><th>编号</th><th>名称</th><th>资质号</th><th>信用等级</th><th>电话</th><th>供货商品数</th><th>操作</th></tr></thead>
    <tbody>
    @if (Model.Items.Any())
    {
        @foreach (var s in Model.Items)
        {
            <tr>
                <td>@s.SupplierID[..8]</td><td>@s.SupplierName</td><td>@s.LicenseNo</td>
                <td>@s.CreditLevel</td><td>@s.ContactPhone</td><td>@s.ProductCount</td>
                <td>
                    <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@s.SupplierID">详情</a>
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@s.SupplierID">编辑</a>
                    <form asp-action="Delete" asp-route-id="@s.SupplierID" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('确定删除？')">删除</button>
                    </form>
                </td>
            </tr>
        }
    }
    else
    {
        <tr><td colspan="7" class="text-center">暂无数据</td></tr>
    }
    </tbody>
</table>
@await Html.PartialAsync("_Pagination", Model)
