@model PagedResult<SupplierDto>
@{
    ViewData["Title"] = "供应商管理";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>🏭 供应商列表</h3>
    <a class="btn btn-success" asp-action="Create">新增供应商</a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark"><tr><th>ID</th><th>名称</th><th>联系人</th><th>电话</th><th>产品数</th><th>操作</th></tr></thead>
    <tbody>
    @if (Model.Items.Any())
    {
        @foreach (var s in Model.Items)
        {
            <tr>
                <td>@s.Id</td><td>@s.Name</td><td>@s.ContactPerson</td><td>@s.Phone</td>
                <td>@s.ProductCount</td>
                <td>
                    <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@s.Id">详情</a>
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@s.Id">编辑</a>
                    <form asp-action="Delete" asp-route-id="@s.Id" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('确定删除？')">删除</button>
                    </form>
                </td>
            </tr>
        }
    }
    else
    {
        <tr><td colspan="6" class="text-center">暂无数据</td></tr>
    }
    </tbody>
</table>
@await Html.PartialAsync("_Pagination", Model)
