@model SupplierProductQuoteDto
@{
    ViewData["Title"] = "商品信息";
    ViewData["BackController"] = "Suppliers";
    ViewData["BackAction"] = "MyQuotes";
    ViewData["BackText"] = "返回我的报价";
    var supplierName = ViewBag.SupplierName as string ?? "供应商";
}
<div class="d-flex justify-content-between align-items-center">
    <h3>商品信息 — @Model.ProductName</h3>
</div>
<p class="text-muted small">
    @supplierName 维护的文字介绍与图片会提供给团长端（团长可参考/复制/改写您的文字，展示您的前 3 张图片）。
</p>

<!-- 文字介绍 -->
<div class="card mb-4">
    <div class="card-header"><h5 class="mb-0">📝 商品文字介绍</h5></div>
    <div class="card-body">
        <form asp-action="SetMyDescription" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" value="@Model.ProductID" />
            <textarea name="description" rows="4" class="form-control"
                      placeholder="例如：产地、品种、规格、口感、存储建议、适用场景……（最多 2000 字）">@Model.Description</textarea>
            <div class="mt-2 d-flex justify-content-end">
                <button type="submit" class="btn btn-primary">保存介绍</button>
            </div>
        </form>
    </div>
</div>

<!-- 商品图片 -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">🖼 商品图片</h5>
        @if (Model.Images.Any())
        {
            <button type="button" class="btn btn-sm btn-outline-secondary" id="toggleManageImages">管理图片</button>
        }
    </div>
    <div class="card-body">
        @if (Model.Images.Any())
        {
            <div class="d-flex flex-wrap gap-3 mb-3">
                @foreach (var img in Model.Images)
                {
                    if (img.HasImageData)
                    {
                        <div class="position-relative">
                            <img src="@img.ImageUrl" alt="@Model.ProductName" class="product-img" onerror="this.style.display='none'" />
                            @if (!img.IsOwned)
                            {
                                <span class="badge bg-secondary position-absolute bottom-0 end-0 m-1" style="font-size:10px;">平台图</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center badge bg-light text-dark border" style="height:120px;width:120px;">
                            <span class="small text-center">⚠ 未上传成功</span>
                        </div>
                    }
                }
            </div>

            <!-- 图片管理区：点“管理图片”展开；只能删除自己上传的图片 -->
            <div id="imageManagePanel" class="border rounded p-3 mb-3" style="display:none;background:#f8f9fa;">
                <div class="text-muted small mb-2">只能删除<b>自己上传</b>的图片；平台通用图由管理员维护。</div>
                @foreach (var img in Model.Images)
                {
                    <div class="d-flex align-items-center gap-3 border-bottom py-2">
                        @if (img.HasImageData)
                        {
                            <img src="@img.ImageUrl" class="product-thumb-sm" onerror="this.style.display='none'" />
                            <span class="small">图片 @img.ImageID</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">未上传成功</span>
                            <span class="small text-muted">@img.ImageID</span>
                        }
                        @if (img.IsOwned)
                        {
                            <form asp-action="DeleteMyProductImage" method="post" class="ms-auto mb-0"
                                  onsubmit="return confirm('确定删除这张图片吗？删除后无法恢复。');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="imageId" value="@img.ImageID" />
                                <input type="hidden" name="productId" value="@Model.ProductID" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">删除</button>
                            </form>
                        }
                        else
                        {
                            <span class="ms-auto badge bg-secondary">平台图 · 不可删除</span>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted small mb-3">暂无图片，请在下方上传（最多 9 张，团长端展示前 3 张）。</p>
        }

        <form asp-action="UploadMyProductImage" method="post" enctype="multipart/form-data" class="d-flex align-items-center gap-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" value="@Model.ProductID" />
            <label class="btn btn-outline-success btn-sm mb-0" style="cursor:pointer;">
                <input type="file" name="imageFile" accept="image/*" hidden
                       onchange="document.getElementById('fileName').textContent = this.files.length ? this.files[0].name : '';" />
                选择图片
            </label>
            <span id="fileName" class="text-muted small">未选择文件（支持 jpg / png / webp / gif，单张 ≤ 5MB）</span>
            <button type="submit" class="btn btn-sm btn-primary" style="flex-shrink:0;">上传</button>
        </form>
    </div>
</div>

@section Scripts {
    <style>
        .product-img { width: 120px; height: 120px; object-fit: cover; border-radius: 8px; border: 1px solid #e5e7eb; }
        .product-thumb-sm { width: 48px; height: 48px; object-fit: cover; border-radius: 6px; border: 1px solid #e5e7eb; }
    </style>
    <script>
        // “管理图片”开关：展开/收起管理区（无图片时按钮不存在，先判空）
        var toggleBtn = document.getElementById('toggleManageImages');
        if (toggleBtn) {
            toggleBtn.addEventListener('click', function () {
                var panel = document.getElementById('imageManagePanel');
                var show = panel.style.display === 'none';
                panel.style.display = show ? 'block' : 'none';
                this.textContent = show ? '收起管理' : '管理图片';
            });
        }
    </script>
}
