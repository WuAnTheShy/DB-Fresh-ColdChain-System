@{
    ViewData["Title"] = "供应商登录";
}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm mt-4">
            <div class="card-body">
                <div class="mb-2">
                    <a class="btn btn-outline-secondary btn-sm" asp-controller="Home" asp-action="Index">← 返回首页</a>
                </div>
                <h4 class="card-title text-center mb-4">🏭 供应商登录</h4>
                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger" data-auto-dismiss>
                            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@err.ErrorMessage</div>
                            }
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label">登录账号</label>
                        <input type="text" name="loginAccount" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">密码</label>
                        <input type="password" name="password" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">登录</button>
                </form>
                <p class="text-muted small mt-3 mb-0">登录后可以维护自己产品的供货价，供货价将在入库时自动作为进价。</p>
            </div>
        </div>
    </div>
</div>
