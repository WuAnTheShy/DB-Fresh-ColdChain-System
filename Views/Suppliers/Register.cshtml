@* 供应商入驻申请页：与团长/管理员注册页保持一致的结构与样式 *@
@model CreateSupplierDto
@{
    ViewData["Title"] = "供应商注册";
    Layout = "_Layout";
}
<link rel="stylesheet" href="~/css/accountsite.css" asp-append-version="true" />

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="selection1 p-4">
                <div class="selection2 mb-3" style="padding: 1.5rem; text-align: center;">
                    <h3 style="font-size: 1.8rem; color: white;">供应商注册</h3>
                    <div style="font-size: 0.9rem; opacity: 0.9; color: white;">正在以 供应商 身份注册</div>
                    <div style="font-size: 0.9rem; opacity: 0.9; color: white;">提交后需等待「账号管理员」审核通过方可登录</div>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert" data-auto-dismiss>
                        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form asp-action="Register" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">名称</label>
                        <input asp-for="SupplierName" class="form-control" placeholder="请输入供应商名称" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">资质编号</label>
                        <input asp-for="LicenseNo" class="form-control" placeholder="请输入资质编号" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">资质到期时间</label>
                        <input asp-for="ExpiryDate" class="form-control" type="date" required />
                        <div class="form-text">资质过期后将无法登录，请如实填写。</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">联系电话</label>
                        <input asp-for="ContactPhone" class="form-control" placeholder="请输入联系电话号码" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">登录账号</label>
                        <input asp-for="LoginAccount" class="form-control" placeholder="请输入用户名" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">登录密码</label>
                        <input asp-for="LoginPassword" class="form-control" type="password" placeholder="请输入密码" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">确认密码</label>
                        <input type="password" class="form-control" name="confirmPassword" placeholder="请再次输入密码" required />
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-lg button1 text-white">提交注册</button>
                    </div>
                </form>

                <div class="text-center mt-4">
                    <a class="back-btn" asp-action="Login" asp-controller="Account" asp-route-role="供应商">返回登录</a>
                </div>
            </div>
        </div>
    </div>
</div>
