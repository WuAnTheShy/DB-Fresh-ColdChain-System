@model SupplierDto
@{
    ViewData["Title"] = $"供应商 — {Model.SupplierName}";
    var quotes = ViewBag.Quotes as List<SupplierProductQuoteDto> ?? new();
}

<div class="page-hero">
    <div>
        <div class="hero-greeting">@Model.SupplierName</div>
        <div class="hero-meta">
            <span class="text-white-50">资质号 @Model.LicenseNo · 信用等级 @Model.CreditLevel</span>
        </div>
    </div>
    <div class="hero-actions">
        <a class="btn btn-light btn-sm" asp-action="Edit" asp-route-id="@Model.SupplierID">编辑</a>
        <a class="btn btn-outline-light btn-sm" asp-action="Index">返回</a>
    </div>
</div>

<div class="content-card">
    <div class="content-card-header">
        <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21V9l5 4V9l5 4V9l8-5v17H3z"/><path d="M3 21h18"/></svg> 基本信息</h5>
    </div>
    <div class="content-card-body">
        <div class="info-row"><div class="info-label">编号</div><div class="info-value"><code class="order-id">@Model.SupplierID</code></div></div>
        <div class="info-row"><div class="info-label">名称</div><div class="info-value">@Model.SupplierName</div></div>
        <div class="info-row"><div class="info-label">资质号</div><div class="info-value">@Model.LicenseNo</div></div>
        <div class="info-row"><div class="info-label">到期时间</div><div class="info-value">@Model.ExpiryDate?.ToString("yyyy-MM-dd")</div></div>
        <div class="info-row"><div class="info-label">信用等级</div><div class="info-value">@Model.CreditLevel</div></div>
        <div class="info-row"><div class="info-label">电话</div><div class="info-value">@Model.ContactPhone</div></div>
        <div class="info-row"><div class="info-label">供货商品数</div><div class="info-value">@Model.ProductCount</div></div>
    </div>
</div>

<div class="content-card mt-3">
    <div class="content-card-header">
        <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg> 供货商品（售价 = 团长进价）</h5>
        <span class="text-muted small">供货价由供应商在「我的货物」统一维护，平台只读</span>
    </div>
    <div class="content-card-body p-0">
        @if (quotes.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light"><tr><th>产品</th><th>当前供货价</th><th>供应商声明保质期</th><th>更新时间</th></tr></thead>
                    <tbody>
                    @foreach (var q in quotes)
                    {
                        var effectiveShelf = q.ShelfLifeHours ?? q.ProductExpiryHours;
                        <tr>
                            <td class="fw-semibold">@q.ProductName</td>
                            <td>@(q.SupplyPrice > 0 ? $"¥{q.SupplyPrice:F2}" : "无售价")</td>
                            <td>@(effectiveShelf.HasValue ? $"{effectiveShelf} 小时（{effectiveShelf / 24.0:0.#} 天）" : "未设置")</td>
                            <td class="small text-muted">@(q.UpdateTime?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg></div>
                <p>该供应商暂无供货产品</p>
            </div>
        }
    </div>
</div>
