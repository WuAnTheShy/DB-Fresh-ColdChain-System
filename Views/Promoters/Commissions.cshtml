@model PromoterCommissionsViewModel
@{
    ViewData["Title"] = "佣金明细";
    var filters = new (string? Value, string Label)[]
    {
        (null, "全部"),
        ("Pending", "待结算"),
        ("Settled", "可提现"),
        ("Refunded", "已退款")
    };
}

<!-- 汇总指标 -->
<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-card-top">
            <span class="stat-icon bg-success-subtle text-success">Σ</span>
            <span class="stat-label">累计佣金（有效）</span>
        </div>
        <div class="stat-value text-success">¥@Model.TotalCommission.ToString("N2")</div>
        <div class="stat-sub">共 @Model.TotalCount 笔记录</div>
    </div>
    <div class="stat-card pending">
        <div class="stat-card-top">
            <span class="stat-icon bg-warning-subtle text-warning">⏳</span>
            <span class="stat-label">待结算</span>
        </div>
        <div class="stat-value text-warning">¥@Model.PendingAmount.ToString("N2")</div>
        <div class="stat-sub">@Model.PendingCount 笔 · 退款保护期内</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-top">
            <span class="stat-icon bg-success-subtle text-success">✓</span>
            <span class="stat-label">可提现</span>
        </div>
        <div class="stat-value">¥@Model.SettledAmount.ToString("N2")</div>
        <div class="stat-sub">@Model.SettledCount 笔 · 已过退款期</div>
    </div>
    <div class="stat-card sales">
        <div class="stat-card-top">
            <span class="stat-icon bg-purple-subtle text-purple">↩</span>
            <span class="stat-label">已退款扣减</span>
        </div>
        <div class="stat-value text-danger">¥@Model.RefundedAmount.ToString("N2")</div>
        <div class="stat-sub">@Model.RefundedCount 笔</div>
    </div>
</div>

<div class="content-card">
    <div class="content-card-header flex-wrap gap-2">
        <h5>佣金记录</h5>
        <div class="filter-tabs">
            @foreach (var (value, label) in filters)
            {
                var isActive = Model.StatusFilter == value || (Model.StatusFilter == null && value == null);
                <a asp-action="Commissions" asp-route-status="@value"
                   class="btn btn-sm @(isActive ? "btn-primary" : "btn-outline-secondary")">
                    @label
                    @{
                        var count = value switch
                        {
                            "Pending" => Model.PendingCount,
                            "Settled" => Model.SettledCount,
                            "Refunded" => Model.RefundedCount,
                            _ => Model.TotalCount
                        };
                    }
                    <span class="badge @(isActive ? "bg-light text-primary" : "bg-secondary") ms-1">@count</span>
                </a>
            }
        </div>
    </div>
    <div class="content-card-body p-0">
        @if (!Model.Items.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">📋</div>
                <p>暂无符合条件的佣金记录</p>
                @if (Model.StatusFilter != null)
                {
                    <a asp-action="Commissions" class="btn btn-sm btn-outline-primary">查看全部</a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>订单号</th>
                            <th>实付金额</th>
                            <th>基础佣金</th>
                            <th>奖励佣金</th>
                            <th>扣减佣金</th>
                            <th>合计</th>
                            <th>签收时间</th>
                            <th>预计结算日</th>
                            <th>状态</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td><code class="order-id">@item.OrderId</code></td>
                                <td>¥@item.FinalAmount.ToString("N2")</td>
                                <td>¥@item.CommBaseAmount.ToString("N2")</td>
                                <td>
                                    @if (item.CommBonusAmount > 0)
                                    {
                                        <span class="text-success fw-semibold">+¥@item.CommBonusAmount.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (item.RefundedAmount > 0)
                                    {
                                        <span class="text-danger fw-semibold">-¥@item.RefundedAmount.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td><strong>¥@item.TotalCommission.ToString("N2")</strong></td>
                                <td class="small text-muted">@(item.SignedAt?.ToString("yyyy-MM-dd") ?? "—")</td>
                                <td class="small text-muted">@(item.CommSettlementDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                                <td><span class="badge bg-@item.StatusBadgeClass">@item.StatusLabel</span></td>
                            </tr>
                        }
                    </tbody>
                    @if (Model.StatusFilter != null)
                    {
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="4" class="text-end text-muted small">当前筛选合计</td>
                                <td><strong>¥@Model.Items.Sum(i => i.TotalCommission).ToString("N2")</strong></td>
                                <td colspan="3"></td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        }
    </div>
</div>

<div class="content-card">
    <div class="content-card-header"><h5>佣金状态说明</h5></div>
    <div class="content-card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="status-tip">
                    <span class="badge bg-warning">待结算</span>
                    <p class="text-muted small mb-0 mt-1">订单已签收，处于 14 天退款保护期，佣金计入待结算余额。</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="status-tip">
                    <span class="badge bg-success">可提现</span>
                    <p class="text-muted small mb-0 mt-1">退款保护期已过，佣金已转入可提现余额，可申请提现。</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="status-tip">
                    <span class="badge bg-danger">已退款扣减</span>
                    <p class="text-muted small mb-0 mt-1">订单发生退款，对应佣金已从余额中扣回。</p>
                </div>
            </div>
        </div>
    </div>
</div>
