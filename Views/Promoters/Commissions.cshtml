@model PromoterCommissionsViewModel
@{
    ViewData["Title"] = "佣金明细";
    var filters = new (string? Value, string Label)[]
    {
        (null, "全部"),
        ("Pending", "待结算"),
        ("Settled", "可提现"),
        ("Refunded", "已退款")
    };
}

<div class="page-hero page-hero-purple hero-photo hero-photo-3">
    <div>
        <div class="hero-greeting">佣金明细</div>
        <div class="hero-meta">
            <span class="text-white-50">共 @Model.TotalCount 笔佣金记录</span>
            <span class="text-white-50">· 待结算 @Model.PendingCount 笔</span>
            <span class="text-white-50">· 可提现 @Model.SettledCount 笔</span>
        </div>
    </div>
    <div class="d-flex align-items-center gap-3">
        <div class="hero-stat-pill">
            <div class="pill-label">累计佣金（有效）</div>
            <div class="pill-value">¥@Model.TotalCommission.ToString("N2")</div>
            <div class="pill-sub">已退款扣减 ¥@Model.RefundedAmount.ToString("N2")</div>
        </div>
        <a asp-action="Withdrawals" class="btn btn-light btn-sm">去提现</a>
    </div>
</div>

<!-- 汇总指标（四框合一，突出文字层次） -->
<div class="overview-card">
    <div class="overview-item">
        <span class="overview-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16"/><path d="M18 6v2.5c0 1.8-1.2 3-3 3.5 1.8.5 3 1.7 3 3.5V18H4"/><path d="M4 18h16"/></svg></span>
        <div class="overview-body">
            <div class="overview-value text-success">¥@Model.TotalCommission.ToString("N2")</div>
            <div class="overview-label">累计佣金（有效）</div>
            <div class="overview-sub">共 @Model.TotalCount 笔记录</div>
        </div>
    </div>
    <div class="overview-item">
        <span class="overview-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
        <div class="overview-body">
            <div class="overview-value text-warning">¥@Model.PendingAmount.ToString("N2")</div>
            <div class="overview-label">待结算</div>
            <div class="overview-sub">@Model.PendingCount 笔 · 退款保护期内</div>
        </div>
    </div>
    <div class="overview-item">
        <span class="overview-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
        <div class="overview-body">
            <div class="overview-value text-success">¥@Model.SettledAmount.ToString("N2")</div>
            <div class="overview-label">可提现</div>
            <div class="overview-sub">@Model.SettledCount 笔 · 已过退款期</div>
        </div>
    </div>
    <div class="overview-item">
        <span class="overview-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v6h6"/><path d="M3 13a9 9 0 1 0 2.6-6.4L3 9"/></svg></span>
        <div class="overview-body">
            <div class="overview-value text-danger">¥@Model.RefundedAmount.ToString("N2")</div>
            <div class="overview-label">已退款扣减</div>
            <div class="overview-sub">@Model.RefundedCount 笔</div>
        </div>
    </div>
</div>

<div class="content-card">
    <div class="content-card-header flex-wrap gap-2">
        <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13"/><path d="M3 6h.01M3 12h.01M3 18h.01"/></svg> 佣金记录</h5>
        <div class="filter-tabs">
            @foreach (var (value, label) in filters)
            {
                var isActive = Model.StatusFilter == value || (Model.StatusFilter == null && value == null);
                <a asp-action="Commissions" asp-route-status="@value"
                   class="btn btn-sm @(isActive ? "btn-primary" : "btn-outline-secondary")">
                    @label
                    @{
                        var count = value switch
                        {
                            "Pending" => Model.PendingCount,
                            "Settled" => Model.SettledCount,
                            "Refunded" => Model.RefundedCount,
                            _ => Model.TotalCount
                        };
                    }
                    <span class="badge @(isActive ? "bg-light text-primary" : "bg-secondary") ms-1">@count</span>
                </a>
            }
        </div>
    </div>
    <div class="content-card-body p-0">
        @if (!Model.Items.Any())
        {
            <div class="empty-state">
                <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/><path d="M14 3v5h5"/><path d="M9 12h6M9 16h6"/></svg></div>
                <p>暂无符合条件的佣金记录</p>
                @if (Model.StatusFilter != null)
                {
                    <a asp-action="Commissions" class="btn btn-sm btn-outline-primary">查看全部</a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>订单号</th>
                            <th>实付金额</th>
                            <th>基础佣金</th>
                            <th>奖励佣金</th>
                            <th>扣减佣金</th>
                            <th>合计</th>
                            <th>签收时间</th>
                            <th>预计结算日</th>
                            <th>状态</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td><code class="order-id">@item.OrderId</code></td>
                                <td>¥@item.FinalAmount.ToString("N2")</td>
                                <td>¥@item.CommBaseAmount.ToString("N2")</td>
                                <td>
                                    @if (item.CommBonusAmount > 0)
                                    {
                                        <span class="text-success fw-semibold">+¥@item.CommBonusAmount.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (item.RefundedAmount > 0)
                                    {
                                        <span class="text-danger fw-semibold">-¥@item.RefundedAmount.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td><strong>¥@item.TotalCommission.ToString("N2")</strong></td>
                                <td class="small text-muted">@(item.SignedAt?.ToString("yyyy-MM-dd") ?? "—")</td>
                                <td class="small text-muted">@(item.CommSettlementDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                                <td><span class="badge bg-@item.StatusBadgeClass">@item.StatusLabel</span></td>
                            </tr>
                        }
                    </tbody>
                    @if (Model.StatusFilter != null)
                    {
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="4" class="text-end text-muted small">当前筛选合计</td>
                                <td><strong>¥@Model.Items.Sum(i => i.TotalCommission).ToString("N2")</strong></td>
                                <td colspan="3"></td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        }
    </div>
</div>

<div class="content-card">
    <div class="content-card-header"><h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 16v-5M12 8h.01"/></svg> 佣金状态说明</h5></div>
    <div class="content-card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="status-tip">
                    <span class="badge bg-warning">待结算</span>
                    <p class="text-muted small mb-0 mt-1">订单已签收，处于 14 天退款保护期，佣金计入待结算余额。</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="status-tip">
                    <span class="badge bg-success">可提现</span>
                    <p class="text-muted small mb-0 mt-1">退款保护期已过，佣金已转入可提现余额，可申请提现。</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="status-tip">
                    <span class="badge bg-danger">已退款扣减</span>
                    <p class="text-muted small mb-0 mt-1">订单发生退款，对应佣金已从余额中扣回。</p>
                </div>
            </div>
        </div>
    </div>
</div>
