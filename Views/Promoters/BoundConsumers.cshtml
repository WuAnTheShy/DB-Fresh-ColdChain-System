@model PromoterBoundConsumersViewModel
@{
    ViewData["Title"] = "我的消费者";
    // 头像底色：按顺序轮换，让方框卡片有辨识度
    var avatarColors = new[] { "#2B96C9", "#2E5870", "#223B46", "#25a96b", "#c2571a" };
}

<partial name="_Alerts" />

<div class="page-hero page-hero-green hero-photo hero-photo-2">
    <div>
        <div class="hero-greeting">我的消费者</div>
        <div class="hero-meta text-white-50">已绑定消费者 <span class="fw-semibold text-white">@Model.TotalCount</span> 人</div>
    </div>
    <div class="hero-actions">
        <a asp-action="BoundConsumers" class="btn btn-light btn-sm">刷新</a>
    </div>
</div>

<div class="content-card">
    <div class="content-card-header">
        <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7 0l2-2a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-2 2a5 5 0 0 0 7 7l1-1"/></svg> 绑定记录</h5>
        <span class="text-muted small">共 @Model.TotalCount 人</span>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="content-card-body p-0">
            <div class="empty-state">
                <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.5 3-5.5 6.5-5.5s6.5 2 6.5 5.5"/><circle cx="17" cy="9" r="2.5"/><path d="M17 14.5c2.5.3 4.5 2 4.5 5"/></svg></div>
                <p>暂时还没有消费者绑定你</p>
                <p class="text-muted small mb-0">消费者在消费者中心搜索并绑定团长后，记录会即时出现在这里。</p>
            </div>
        </div>
    }
    else
    {
        <div class="consumer-grid">
            @{ var index = 0; }
            @foreach (var item in Model.Items)
            {
                var hasName = !string.IsNullOrWhiteSpace(item.CustomerName);
                var initial = hasName ? item.CustomerName!.Trim().Substring(0, 1) : string.Empty;
                var avatarColor = avatarColors[index % avatarColors.Length];
                index++;

                <article class="consumer-card">
                    <div class="consumer-card-head">
                        @if (hasName)
                        {
                            <span class="consumer-avatar" style="background:@avatarColor">@initial</span>
                        }
                        else
                        {
                            <span class="consumer-avatar is-empty">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.6"/><path d="M4.5 20c0-3.8 3.4-6 7.5-6s7.5 2.2 7.5 6"/></svg>
                            </span>
                        }
                        <div class="consumer-identity">
                            <strong>@(hasName ? item.CustomerName : "未填写姓名")</strong>
                            <small>团内消费者</small>
                        </div>
                        <span class="consumer-status-badge">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                            已绑定
                        </span>
                    </div>

                    <div class="consumer-card-divider"></div>

                    <div class="consumer-card-body">
                        <div class="consumer-contact">
                            <span class="consumer-contact-label">联系电话</span>
                            @if (string.IsNullOrWhiteSpace(item.Phone))
                            {
                                <span class="consumer-contact-value is-empty">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.4-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
                                    暂未提供
                                </span>
                            }
                            else
                            {
                                <span class="consumer-contact-value">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.4-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
                                    @item.Phone
                                </span>
                            }
                        </div>

                        <div class="consumer-card-meta">
                            <span class="consumer-id-badge" title="@item.CustomerId">ID · @item.CustomerId</span>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>
