@model FreshColdChain.Models.ViewModels.ProductEntryDetailViewModel
@{
    ViewData["Title"] = "商品详情 · " + Model.Entry.ProductName;
    var p = Model.Entry;
    var unit = string.IsNullOrWhiteSpace(p.Unit) ? "" : p.Unit.Trim();
    var priceDiff = Math.Abs(p.DefaultPrice - p.SupplyPrice) / 2m;
    var priceMin = p.DefaultPrice - priceDiff;
    var priceMax = p.DefaultPrice + priceDiff;
    var currentPrice = p.PromoterPrice ?? p.DefaultPrice;
    // 当前图文介绍的文字摘要（RichContent 已由服务把历史纯文字包装为段落）
    var introPlain = Model.RichContent?.ToPlainText();
    var hasIntro = !string.IsNullOrWhiteSpace(introPlain);
}

<link rel="stylesheet" href="~/css/promoter-entry-detail.css" asp-append-version="true" />

<partial name="_Alerts" />

<style>
    .entry-detail-page { display: flex; flex-direction: column; gap: 14px; }
    .entry-detail-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
    .entry-breadcrumb { font-size: 12px; color: #718096; }
    .entry-detail-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; box-shadow: 0 1px 4px rgba(0, 0, 0, .06); }
    .entry-detail-main { display: grid; grid-template-columns: minmax(230px, .8fr) minmax(290px, 1fr) 310px; gap: 24px; padding: 24px; }
    .entry-gallery { display: grid; grid-template-columns: 58px minmax(0, 1fr); gap: 10px; align-items: start; }
    .entry-gallery-main { position: relative; grid-column: 2; aspect-ratio: 1 / 1; border-radius: 10px; overflow: hidden; background: #f1f5f9; display: flex; align-items: center; justify-content: center; border: 1px solid #eef2f6; }
    .entry-gallery-main img { width: 100%; height: 100%; object-fit: cover; }
    .entry-gallery-main .img-empty { color: #a0aec0; font-size: 13px; text-align: center; line-height: 1.6; padding: 12px; }
    .entry-gallery-thumbs { grid-column: 1; grid-row: 1; display: flex; flex-direction: column; gap: 8px; }
    .entry-gallery-thumbs img { width: 58px; height: 58px; object-fit: cover; border-radius: 8px; border: 2px solid #e2e8f0; cursor: pointer; background: #fff; }
    .entry-gallery-thumbs img.active { border-color: #2B96C9; }
    .entry-info { min-width: 0; }
    .entry-deal-label { display: inline-flex; margin-bottom: 10px; padding: 4px 9px; border-radius: 4px; background: #fce9e7; color: #d64545; font-size: 11px; font-weight: 700; }
    .entry-title { margin: 0 0 6px; font-size: 24px; font-weight: 800; line-height: 1.35; color: #223B46; word-break: break-word; }
    .entry-title small { font-weight: 400; color: #718096; font-size: 14px; }
    .entry-sub { margin: 0 0 16px; color: #718096; line-height: 1.65; font-size: 13px; }
    .entry-supplier-panel { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 4px 10px; padding: 12px 14px; margin-bottom: 14px; border: 1px solid #cfe1d8; background: #f2f8f5; border-radius: 8px; font-size: 13px; }
    .entry-supplier-panel .sp-label { color: #718096; }
    .entry-supplier-panel .sp-value { color: #223B46; font-weight: 600; word-break: break-all; }
    .entry-facts { margin: 0; }
    .entry-facts > div { display: grid; grid-template-columns: 120px 1fr; gap: 8px; padding: 11px 2px; border-bottom: 1px solid #f0f4f7; font-size: 13px; }
    .entry-facts > div:last-child { border-bottom: 0; }
    .entry-facts dt { color: #718096; }
    .entry-facts dd { margin: 0; color: #2d3748; font-weight: 600; }
    .entry-facts dd.text-success-strong { color: #2B96C9; }
    .entry-price-box { align-self: start; background: #f8fbfa; border: 1px solid #d7e0dc; border-radius: 12px; padding: 18px; box-shadow: 0 3px 10px rgba(23, 33, 29, .06); }
    .price-now-label { font-size: 12px; color: #718096; }
    .price-now-value { display: flex; align-items: baseline; gap: 2px; color: #d64545; font-weight: 800; }
    .price-now-value .cur { font-size: 15px; }
    .price-now-value strong { font-size: 32px; line-height: 1.2; }
    .price-ref-row { display: flex; gap: 8px; flex-wrap: wrap; margin: 6px 0 14px; font-size: 12px; color: #718096; }
    .price-ref-row b { color: #2d3748; font-weight: 600; }
    .price-form label { display: block; margin-bottom: 6px; font-size: 13px; color: #2d3748; font-weight: 600; }
    .price-form .input-holder { display: flex; align-items: center; gap: 6px; }
    .price-form .input-holder .prefix { font-size: 18px; color: #d64545; font-weight: 700; }
    .rule-tip { margin-top: 8px; padding: 9px 11px; border-radius: 6px; background: #eef4f8; color: #4a5568; font-size: 12px; line-height: 1.6; }
    .price-form .btn { margin-top: 12px; }
    .entry-desc-section { padding: 22px 24px; }
    .entry-desc-section > h2 { margin: 0 0 4px; font-size: 17px; font-weight: 700; color: #223B46; }
    .entry-desc-section > .desc-hint { margin: 0 0 14px; color: #718096; font-size: 12px; }
    .entry-desc-section textarea { resize: vertical; }
    .desc-save-row { display: flex; justify-content: flex-end; margin-top: 10px; }
    .supplier-origin { margin-top: 18px; padding: 14px 16px; border-radius: 8px; background: #f7fafc; border: 1px dashed #cbd5e0; }
    .supplier-origin h3 { margin: 0 0 8px; font-size: 13px; color: #2E5870; font-weight: 700; }
    .supplier-origin .origin-text { margin: 0 0 10px; color: #4a5568; font-size: 13px; line-height: 1.7; white-space: pre-wrap; word-break: break-word; }
    .preview-note { margin-top: 16px; padding: 12px 14px; border-left: 4px solid #2B96C9; background: #f2f8f5; color: #4a5568; font-size: 13px; line-height: 1.7; border-radius: 0 6px 6px 0; }
    .preview-note b { color: #223B46; }
    .preview-note .preview-text { display: block; margin-top: 4px; white-space: pre-wrap; word-break: break-word; }

    @@media (max-width: 1199.98px) {
        .entry-detail-main { grid-template-columns: minmax(220px, .9fr) minmax(280px, 1fr); }
        .entry-price-box { grid-column: 1 / -1; }
    }
    @@media (max-width: 767.98px) {
        .entry-detail-main { grid-template-columns: 1fr; padding: 16px; gap: 18px; }
        .entry-price-box { grid-column: auto; }
        .entry-gallery { grid-template-columns: 46px minmax(0, 1fr); }
        .entry-gallery-thumbs img { width: 46px; height: 46px; }
    }
</style>

<div class="entry-detail-page">
    <!-- 顶栏：返回 + 路径 -->
    <div class="entry-detail-toolbar">
        <a asp-action="ProductListing" asp-route-keyword="@Model.Keyword" class="btn btn-outline-secondary btn-sm">← 返回商品上架</a>
        <span class="entry-breadcrumb">商品上架 / 商品详情 · @p.ProductName</span>
    </div>

    @if (!p.IsProductActive)
    {
        <div class="alert alert-warning mb-0">
            ⚠ 该商品的供应商已将其<b>下架</b>，消费者端将不再可见。您仍可保留该条目，待供应商恢复上架后自动恢复展示；也可将其移出商品列表。
        </div>
    }

    <!-- 商品信息主区：左图 / 中信息 / 右定价编辑 -->
    <section class="entry-detail-card entry-detail-main">
        <div class="entry-gallery">
            @if (p.Images.Any())
            {
                <div class="entry-gallery-thumbs" id="thumbList">
                    @foreach (var img in p.Images)
                    {
                        <img src="@img" alt="商品图" data-src="@img" class="@(img == p.Images[0] ? "active" : "")" onerror="this.style.display='none'" />
                    }
                </div>
                <div class="entry-gallery-main">
                    <img id="mainImage" src="@p.Images[0]" alt="@p.ProductName" onerror="this.parentElement.innerHTML='<div class=&quot;img-empty&quot;>暂无商品图片</div>'" />
                </div>
            }
            else
            {
                <div class="entry-gallery-main" style="grid-column:1 / -1;">
                    <div class="img-empty">📷<br />暂无商品图片</div>
                </div>
            }
        </div>

        <div class="entry-info">
            <span class="entry-deal-label">团长精选 · 冷链直送</span>
            <h1 class="entry-title">@p.ProductName @if (!string.IsNullOrEmpty(unit))
            {
                <small>（@unit）</small>
            }</h1>
            @if (hasIntro)
            {
                var plain = introPlain!.Trim();
                <p class="entry-sub">@(plain.Length > 100 ? plain.Substring(0, 100) + "…" : plain)</p>
            }
            else
            {
                <p class="entry-sub">尚未撰写图文介绍：可在下方编写标题与“文字+图片”段落，消费者端将按图文段落展示。</p>
            }
            <div class="entry-supplier-panel">
                <span class="sp-label">供货供应商</span>
                <span class="sp-value">@p.SupplierName</span>
                <span class="sp-label">供应商编号</span>
                <span class="sp-value"><code class="small">@p.SupplierID</code></span>
            </div>
            <dl class="entry-facts">
                <div><dt>供应商报价</dt><dd>￥@p.SupplyPrice.ToString("F2")</dd></div>
                <div><dt>商品推荐价</dt><dd>￥@p.DefaultPrice.ToString("F2")</dd></div>
                <div><dt>允许定价范围</dt><dd>￥@priceMin.ToString("F2") ~ ￥@priceMax.ToString("F2")</dd></div>
                <div><dt>当前团长定价</dt><dd class="text-success-strong">￥@currentPrice.ToString("F2")</dd></div>
            </dl>
        </div>

        <!-- 右侧：团长定价编辑 -->
        <aside class="entry-price-box">
            <div class="price-now-label">当前团长定价（消费者端售价）</div>
            <div class="price-now-value"><span class="cur">￥</span><strong>@currentPrice.ToString("F2")</strong></div>
            <div class="price-ref-row">
                <span>报价 <b>￥@p.SupplyPrice.ToString("F2")</b></span>
                <span>推荐价 <b>￥@p.DefaultPrice.ToString("F2")</b></span>
            </div>
            <form asp-action="UpdateEntryPrice" method="post" class="price-form" id="priceForm">
                <input type="hidden" name="productId" value="@p.ProductID" />
                <input type="hidden" name="supplierId" value="@p.SupplierID" />
                <input type="hidden" name="keyword" value="@Model.Keyword" />
                <input type="hidden" name="supplyPrice" value="@p.SupplyPrice" />
                <input type="hidden" name="defaultPrice" value="@p.DefaultPrice" />
                <label for="priceInput">调整团长定价 @(!string.IsNullOrEmpty(unit) ? $"（元/{unit}）" : "（元）")</label>
                <div class="input-holder">
                    <span class="prefix">￥</span>
                    <input type="number" step="0.1" min="0.1" id="priceInput" name="price"
                           class="form-control form-control-lg" style="font-weight:700;"
                           value="@currentPrice.ToString("F1")"
                           placeholder="默认￥@p.DefaultPrice.ToString("F1")" />
                </div>
                <div class="rule-tip">
                    定价规则：<b>|团长价 - 推荐价| &lt; |推荐价 - 报价| / 2</b>，
                    即允许范围 ￥@priceMin.ToString("F2") ~ ￥@priceMax.ToString("F2")；留空则按推荐价 ￥@p.DefaultPrice.ToString("F2") 展示。
                </div>
                <button type="submit" class="btn btn-primary w-100">保存定价</button>
            </form>
        </aside>
    </section>

    <!-- 商品介绍区（图文编辑器，独立局部视图承载交互逻辑） -->
    <partial name="_RichIntroEditor" model="Model" />
</div>

@section Scripts {
    <script>
        // 缩略图切换主图
        document.querySelectorAll('#thumbList img').forEach(function (thumb) {
            thumb.addEventListener('click', function () {
                var main = document.getElementById('mainImage');
                if (!main) return;
                main.src = thumb.getAttribute('data-src');
                document.querySelectorAll('#thumbList img').forEach(function (t) { t.classList.remove('active'); });
                thumb.classList.add('active');
            });
        });

        // 团长定价校验：|团长价 - 推荐价| < |推荐价 - 报价| / 2（留空 = 使用推荐价）
        var priceForm = document.getElementById('priceForm');
        if (priceForm) {
            priceForm.addEventListener('submit', function (e) {
                var input = document.getElementById('priceInput');
                if (!input) return;
                var raw = input.value.trim();
                if (raw === '') return; // 留空，服务端按推荐价处理
                var price = parseFloat(raw);
                var supply = parseFloat(priceForm.querySelector('input[name="supplyPrice"]').value);
                var def = parseFloat(priceForm.querySelector('input[name="defaultPrice"]').value);
                if (isNaN(price) || price <= 0) {
                    e.preventDefault();
                    alert('请输入有效的团长定价，或留空使用推荐价。');
                    return;
                }
                var allowed = Math.abs(def - supply) / 2;
                if (allowed === 0 ? price !== def : Math.abs(price - def) >= allowed) {
                    e.preventDefault();
                    alert('定价超出允许范围：|团长价 - 推荐价| 必须小于 |推荐价 - 报价| / 2（即 ' + allowed.toFixed(2) + ' 元），当前已超出。');
                }
            });
        }
    </script>
}
