@model PromoterDashboardViewModel
@{
    ViewData["Title"] = "工作台";
    var p = Model.Promoter;
    var commissionRateDisplay = p.BaseCommissionRate < 1 ? p.BaseCommissionRate * 100 : p.BaseCommissionRate;
}

<partial name="_Alerts" />

<!-- 欢迎横幅 -->
<div class="dashboard-hero hero-photo hero-photo-1">
    <div class="hero-text">
        <div class="hero-greeting">你好，@p.PromoterName <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg></div>
        <div class="hero-meta">
            <span class="level-badge">@Model.LevelName</span>
            <span class="text-white-50">· 基础佣金 @Model.CurrentTierRate%</span>
            <span class="text-white-50">· 累计 @p.TotalOrderCount 笔订单</span>
        </div>
    </div>
    <div class="hero-actions">
        <a asp-action="Withdrawals" class="btn btn-light btn-sm">申请提现</a>
    </div>
</div>

@if (Model.HasPendingWithdrawal)
{
    <div class="alert alert-warning d-flex align-items-center gap-2 mb-3">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
        <span>您有一笔提现申请正在审核中，审核完成前无法再次申请。</span>
        <a asp-action="Withdrawals" class="ms-auto btn btn-sm btn-outline-warning">查看详情</a>
    </div>
}

<div class="row g-3">
    <!-- 左栏 -->
    <div class="col-lg-8">
        <!-- 我的佣金（本月概览 + 最近记录 二合一） -->
        <div class="content-card">
            <div class="content-card-header">
                <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v9"/><path d="M9.5 10h5M9.5 13.5h5"/></svg> 我的佣金</h5>
                <span class="d-flex align-items-center gap-2">
                    <span class="text-muted small">@DateTime.Today.ToString("yyyy年MM月")</span>
                    <a asp-action="Commissions" class="btn btn-sm btn-outline-primary">查看全部</a>
                </span>
            </div>
            <div class="content-card-body">
                <div class="row g-3 text-center pb-3 mb-3 border-bottom">
                    <div class="col-6 col-md-3">
                        <div class="mini-stat-value text-primary">¥@Model.MonthCommissionTotal.ToString("N2")</div>
                        <div class="mini-stat-label">本月佣金</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="mini-stat-value text-warning">¥@p.PendingBalance.ToString("N2")</div>
                        <div class="mini-stat-label">待结算佣金 · @Model.PendingCommissionCount 笔</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="mini-stat-value text-info">¥@p.FrozenAmount.ToString("N2")</div>
                        <div class="mini-stat-label">冻结金额</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="mini-stat-value text-success">@Model.SettledCommissionCount</div>
                        <div class="mini-stat-label">可提现笔数</div>
                    </div>
                </div>
                @if (!Model.RecentCommissions.Any())
                {
                    <div class="empty-state">
                        <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/><path d="M14 3v5h5"/><path d="M9 12h6M9 16h6"/></svg></div>
                        <p>暂无佣金记录</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>订单号</th>
                                    <th>实付</th>
                                    <th>基础佣金</th>
                                    <th>奖励佣金</th>
                                    <th>退款扣减</th>
                                    <th>预计结算</th>
                                    <th>状态</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.RecentCommissions)
                                {
                                    <tr>
                                        <td><code class="order-id">@item.OrderId</code></td>
                                        <td>¥@item.FinalAmount.ToString("N2")</td>
                                        <td>¥@item.CommBaseAmount.ToString("N2")</td>
                                        <td>
                                            @if (item.CommBonusAmount > 0)
                                            {
                                                <span class="text-success">+¥@item.CommBonusAmount.ToString("N2")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.RefundedAmount > 0)
                                            {
                                                <span class="text-danger">-¥@item.RefundedAmount.ToString("N2")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td class="small text-muted">@(item.CommSettlementDate?.ToString("MM-dd") ?? "—")</td>
                                        <td><span class="badge bg-@item.StatusBadgeClass">@item.StatusLabel</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- 最近提现（含可提现余额） -->
        <div class="content-card">
            <div class="content-card-header">
                <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m8 11 4 4 4-4"/><path d="M4 19h16"/></svg> 最近提现</h5>
                <span class="d-flex align-items-center gap-2">
                    <span class="text-muted small">可提现余额</span>
                    <span class="fw-bold text-success">¥@p.CurrentBalance.ToString("N2")</span>
                    <a asp-action="Withdrawals" class="btn btn-sm btn-outline-primary">申请提现</a>
                </span>
            </div>
            <div class="content-card-body p-0">
                @if (Model.RecentWithdrawals.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>申请编号</th>
                                    <th>金额</th>
                                    <th>申请时间</th>
                                    <th>状态</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var w in Model.RecentWithdrawals)
                                {
                                    <tr>
                                        <td><code class="order-id">@w.WithdrawalId</code></td>
                                        <td>¥@w.ApplyAmount.ToString("N2")</td>
                                        <td class="small text-muted">@w.ApplyTime.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td><span class="badge bg-@w.AuditStatusBadgeClass">@w.AuditStatusLabel</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state py-4">
                        <p class="mb-0">暂无提现记录</p>
                    </div>
                }
            </div>
        </div>

        <!-- 快速查看：已上架商品 + 团内消费者（左下角） -->
        <div class="content-card">
            <div class="content-card-header">
                <h5><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"/></svg> 快速查看</h5>
            </div>
            <div class="content-card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg> 已上架商品</span>
                                <span class="badge badge-slate">@Model.ListedProducts.Count</span>
                            </div>
                            @if (Model.ListedProducts.Any())
                            {
                                <ul class="list-unstyled small mb-2">
                                    @foreach (var lp in Model.ListedProducts.Take(5))
                                    {
                                        <li class="d-flex justify-content-between align-items-center border-bottom py-1">
                                            <span>@lp.ProductName <span class="text-muted">· @lp.SupplierName</span></span>
                                            <span class="d-inline-flex align-items-center gap-2">
                                                @if (!lp.IsProductActive)
                                                {
                                                    <span class="badge bg-danger">已下架</span>
                                                }
                                                <span class="text-success fw-bold">￥@((lp.PromoterPrice ?? lp.DefaultPrice).ToString("F2"))</span>
                                            </span>
                                        </li>
                                    }
                                </ul>
                                @if (Model.ListedProducts.Count > 5)
                                {
                                    <div class="text-muted small mb-2">… 共 @Model.ListedProducts.Count 件商品</div>
                                }
                            }
                            else
                            {
                                <div class="text-muted small mb-2">暂无上架商品</div>
                            }
                            <a asp-action="ProductListing" class="btn btn-sm btn-outline-primary w-100">去商品上架</a>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.5 3-5.5 6.5-5.5s6.5 2 6.5 5.5"/><circle cx="17" cy="9" r="2.5"/><path d="M17 14.5c2.5.3 4.5 2 4.5 5"/></svg> 团内消费者</span>
                                <span class="badge badge-slate">@Model.BoundCustomers.Count</span>
                            </div>
                            @if (Model.BoundCustomers.Any())
                            {
                                <ul class="list-unstyled small mb-2">
                                    @foreach (var c in Model.BoundCustomers.Take(5))
                                    {
                                        <li class="d-flex justify-content-between border-bottom py-1">
                                            <span>@c.CustomerName</span>
                                            <span class="text-muted">@c.Phone</span>
                                        </li>
                                    }
                                </ul>
                                @if (Model.BoundCustomers.Count > 5)
                                {
                                    <div class="text-muted small mb-2">… 共 @Model.BoundCustomers.Count 人</div>
                                }
                            }
                            else
                            {
                                <div class="text-muted small mb-2">暂无绑定消费者</div>
                            }
                            <a asp-action="BoundConsumers" class="btn btn-sm btn-outline-primary w-100">查看团内消费者</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 右栏 -->
    <div class="col-lg-4">
        <!-- 等级进度 -->
        <div class="content-card">
            <div class="content-card-header">
                <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-8"/><path d="M14 7h7v7"/></svg> 等级晋升</h5>
                <a asp-action="Performance" class="btn btn-sm btn-outline-primary">业绩详情</a>
            </div>
            <div class="content-card-body">
                <div class="mb-3 pb-3 border-bottom">
                    <div class="mini-stat-label mb-1">累计有效销售额</div>
                    <div class="mini-stat-value">¥@p.TotalSales.ToString("N2")</div>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="level-badge-lg">@Model.LevelName</span>
                    <span class="text-muted small">佣金 @Model.CurrentTierRate%</span>
                </div>
                @if (Model.IsMaxTier)
                {
                    <div class="alert alert-success py-2 mb-0 small">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.1 4.6 5 .6-3.7 3.4.9 5L12 14.6 7.7 16.6l.9-5L4.9 8.2l5-.6z"/></svg>
                        已达最高等级「@Model.LevelName」，基础佣金比例 @Model.CurrentTierRate%
                    </div>
                }
                else
                {
                    <div class="tier-progress-wrap mb-2">
                        <div class="tier-bar">
                            <div class="tier-bar-fill" style="width:@Model.TierProgressPercent.ToString("F1")%"></div>
                        </div>
                        <div class="tier-labels">
                            <span>¥@p.TotalSales.ToString("N0")</span>
                            <span>¥@Model.NextTierThreshold.ToString("N0")</span>
                        </div>
                    </div>
                    <p class="text-muted small mb-0">
                        晋升「<strong>@Model.NextTierName</strong>」还需
                        <strong>¥@((Model.NextTierThreshold - p.TotalSales).ToString("N2"))</strong>，
                        将获得 <strong>¥@Model.NextTierBonus.ToString("N0")</strong> 里程碑奖励
                    </p>
                }
            </div>
        </div>

        <!-- 账户信息摘要 -->
        <div class="content-card">
            <div class="content-card-header">
                <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="11" r="2.2"/><path d="M15 10h4M15 14h4"/></svg> 账户摘要</h5>
                <a asp-action="Profile" class="btn btn-sm btn-outline-primary">账户详情</a>
            </div>
            <div class="content-card-body py-2">
                <div class="info-row compact">
                    <span class="info-label">团长编号</span>
                    <span class="info-value"><code>@p.PromoterId</code></span>
                </div>
                <div class="info-row compact">
                    <span class="info-label">平台设定比例</span>
                    <span class="info-value">@commissionRateDisplay%</span>
                </div>
                <div class="info-row compact">
                    <span class="info-label">注册时间</span>
                    <span class="info-value">@p.RegisterTime.ToString("yyyy-MM-dd")</span>
                </div>
                <div class="info-row compact">
                    <span class="info-label">最近结算</span>
                    <span class="info-value">@(p.LastSettlementTime?.ToString("yyyy-MM-dd") ?? "暂无")</span>
                </div>
            </div>
        </div>
    </div>
</div>
