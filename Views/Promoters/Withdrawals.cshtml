@model PromoterWithdrawalsViewModel
@{
    ViewData["Title"] = "提现管理";
}

<partial name="_Alerts" />

<div class="page-hero page-hero-purple hero-photo hero-photo-3">
    <div>
        <div class="hero-greeting">提现管理</div>
        <div class="hero-meta">
            <span class="text-white-50">@Model.PromoterName</span>
            <span class="text-white-50">· 审核中 @Model.PendingCount 笔</span>
            <span class="text-white-50">· 累计已提现 ¥@Model.TotalWithdrawn.ToString("N2")</span>
        </div>
    </div>
    <div class="d-flex align-items-center gap-3">
        <div class="hero-stat-pill">
            <div class="pill-label">可提现余额</div>
            <div class="pill-value">¥@Model.CurrentBalance.ToString("N2")</div>
            <div class="pill-sub">冻结中 ¥@Model.FrozenAmount.ToString("N2")</div>
        </div>
        @if (Model.CanApply)
        {
            <a href="#withdrawForm" class="btn btn-light btn-sm">立即申请</a>
        }
    </div>
</div>

<!-- 提现指标（三框合一，突出文字层次） -->
<div class="overview-card">
    <div class="overview-item">
        <span class="overview-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 12h.01M18 12h.01"/></svg></span>
        <div class="overview-body">
            <div class="overview-value text-success">¥@Model.CurrentBalance.ToString("N2")</div>
            <div class="overview-meta">
                <span class="overview-label">可提现余额</span>
                <span class="overview-sub">随时可申请提现</span>
            </div>
        </div>
    </div>
    <div class="overview-item">
        <span class="overview-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
        <div class="overview-body">
            <div class="overview-value text-warning">¥@Model.FrozenAmount.ToString("N2")</div>
            <div class="overview-meta">
                <span class="overview-label">冻结中</span>
                <span class="overview-sub">@Model.PendingCount 笔审核中</span>
            </div>
        </div>
    </div>
    <div class="overview-item">
        <span class="overview-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20V10"/><path d="M9 20V4"/><path d="M15 20v-8"/><path d="M21 20V7"/></svg></span>
        <div class="overview-body">
            <div class="overview-value">¥@Model.TotalWithdrawn.ToString("N2")</div>
            <div class="overview-meta">
                <span class="overview-label">累计已提现</span>
                <span class="overview-sub">历史成功提现总额</span>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="content-card" id="withdrawForm">
            <div class="content-card-header"><h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m8 11 4 4 4-4"/><path d="M4 19h16"/></svg> 申请提现</h5></div>
            <div class="content-card-body">
                @if (!Model.CanApply)
                {
                    <div class="alert alert-warning mb-0 d-flex gap-2 align-items-start">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                        <span>@Model.BlockReason</span>
                    </div>
                }
                else
                {
                    <form asp-action="Withdrawals" method="post" id="withdrawApplyForm">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between">
                                <span>提现金额（元）</span>
                                <span class="text-muted small">最多 ¥@Model.CurrentBalance.ToString("N2")</span>
                            </label>
                            <input asp-for="Form.ApplyAmount" id="applyAmount" type="number"
                                   step="0.01" min="0.01" max="@Model.CurrentBalance"
                                   class="form-control form-control-lg" placeholder="请输入提现金额" required />
                            <div class="quick-amounts mt-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary quick-amt" data-amt="@Model.CurrentBalance">全部</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary quick-amt" data-amt="500">500</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary quick-amt" data-amt="1000">1000</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary quick-amt" data-amt="2000">2000</button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">收款平台</label>
                            <select asp-for="Form.AccountPlatform" class="form-select" id="accountPlatform" required>
                                @foreach (var item in Model.PayAccounts)
                                {
                                    <option value="@item.Platform">@item.Label@(item.IsBound ? "" : "（未绑定）")</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">收款账户信息</label>
                            <input asp-for="Form.AccountInfo" class="form-control" id="accountInfo"
                                   placeholder="请先绑定收款账户" readonly required />
                            <div class="form-text text-danger d-none" id="accountBindHint">请先在「<a asp-action="Profile">个人资料</a> → 收款账户绑定」中绑定该账户，再提交提现。</div>
                        </div>
                        <button type="submit" class="btn btn-success w-100 btn-lg" id="submitWithdrawBtn">提交提现申请</button>
                    </form>
                }
            </div>
        </div>

        <div class="content-card">
            <div class="content-card-header"><h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13"/><path d="M3 6h.01M3 12h.01M3 18h.01"/></svg> 提现流程</h5></div>
            <div class="content-card-body">
                <div class="flow-steps">
                    <div class="flow-step"><span class="flow-num">1</span>提交申请，余额转入冻结</div>
                    <div class="flow-step"><span class="flow-num">2</span>平台审核（1~3 工作日）</div>
                    <div class="flow-step"><span class="flow-num">3</span>审核通过，转账至收款账户</div>
                    <div class="flow-step"><span class="flow-num">4</span>驳回则金额退回可提现余额</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="content-card">
            <div class="content-card-header">
                <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/><path d="M12 8v4l3 2"/></svg> 提现记录</h5>
                <span class="text-muted small">共 @Model.Records.Count 条</span>
            </div>
            <div class="content-card-body p-0">
                @if (!Model.Records.Any())
                {
                    <div class="empty-state">
                        <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/><path d="M6 15h4"/></svg></div>
                        <p>暂无提现记录</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>申请编号</th>
                                    <th>金额</th>
                                    <th>收款账户</th>
                                    <th>申请时间</th>
                                    <th>状态</th>
                                    <th>备注</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.Records)
                                {
                                    <tr>
                                        <td><code class="order-id">@r.WithdrawalId</code></td>
                                        <td class="fw-semibold">¥@r.ApplyAmount.ToString("N2")</td>
                                        <td class="small">@r.AccountInfo</td>
                                        <td class="small text-muted">@r.ApplyTime.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td><span class="badge bg-@r.AuditStatusBadgeClass">@r.AuditStatusLabel</span></td>
                                        <td class="small">
                                            @if (r.AuditStatus == "Rejected")
                                            {
                                                <span class="text-danger">@r.RejectReason</span>
                                            }
                                            else if (r.TransferTime.HasValue)
                                            {
                                                <span class="text-muted">转账 @r.TransferTime.Value.ToString("yyyy-MM-dd")</span>
                                            }
                                            else if (r.AuditStatus == "Pending")
                                            {
                                                <span class="text-warning">审核中…</span>
                                            }
                                            else
                                            {
                                                @:—
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.quick-amt').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var amt = parseFloat(btn.dataset.amt);
                var max = @Model.CurrentBalance.ToString(System.Globalization.CultureInfo.InvariantCulture);
                document.getElementById('applyAmount').value = Math.min(amt, max).toFixed(2);
            });
        });

        (function () {
            var bound = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.PayAccounts.ToDictionary(a => a.Platform, a => a.AccountNo ?? string.Empty)));
            var platformEl = document.getElementById('accountPlatform');
            var accountEl = document.getElementById('accountInfo');
            var hintEl = document.getElementById('accountBindHint');
            var submitBtn = document.getElementById('submitWithdrawBtn');
            var form = document.getElementById('withdrawApplyForm');
            if (!platformEl || !accountEl) return;

            function syncAccount() {
                var platform = platformEl.value;
                var account = (bound[platform] || '').trim();
                accountEl.value = account;
                var unbound = !account;
                hintEl.classList.toggle('d-none', !unbound);
                accountEl.classList.toggle('is-invalid', unbound);
                if (submitBtn) submitBtn.disabled = unbound;
            }

            platformEl.addEventListener('change', syncAccount);
            if (form) {
                form.addEventListener('submit', function (e) {
                    var account = (accountEl.value || '').trim();
                    var amount = parseFloat(document.getElementById('applyAmount').value);
                    if (!account) {
                        e.preventDefault();
                        syncAccount();
                        alert('收款账户不能为空，请先到「个人资料 → 收款账户绑定」绑定微信 / 支付宝 / 银行卡。');
                        return;
                    }
                    if (!amount || amount <= 0) {
                        e.preventDefault();
                        alert('请输入有效的提现金额。');
                    }
                });
            }
            syncAccount();
        })();
    </script>
}
