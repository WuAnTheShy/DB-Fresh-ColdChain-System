@model PromoterWithdrawalsViewModel
@{
    ViewData["Title"] = "提现管理";
}

<partial name="_Alerts" />

<div class="page-hero page-hero-green">
    <div>
        <div class="hero-greeting">提现管理</div>
        <div class="hero-meta text-white-50">@Model.PromoterName · 可提现 ¥@Model.CurrentBalance.ToString("N2")</div>
    </div>
    @if (Model.CanApply)
    {
        <a href="#withdrawForm" class="btn btn-light btn-sm">立即申请</a>
    }
</div>

<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-card-top">
            <span class="stat-icon bg-success-subtle text-success">¥</span>
            <span class="stat-label">可提现余额</span>
        </div>
        <div class="stat-value text-success">@Model.CurrentBalance.ToString("N2")</div>
        <div class="stat-sub">随时可申请提现</div>
    </div>
    <div class="stat-card frozen">
        <div class="stat-card-top">
            <span class="stat-icon bg-info-subtle text-info">🔒</span>
            <span class="stat-label">冻结中</span>
        </div>
        <div class="stat-value text-info">@Model.FrozenAmount.ToString("N2")</div>
        <div class="stat-sub">@Model.PendingCount 笔审核中</div>
    </div>
    <div class="stat-card sales">
        <div class="stat-card-top">
            <span class="stat-icon bg-purple-subtle text-purple">↓</span>
            <span class="stat-label">累计已提现</span>
        </div>
        <div class="stat-value">@Model.TotalWithdrawn.ToString("N2")</div>
        <div class="stat-sub">历史成功提现总额</div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="content-card" id="withdrawForm">
            <div class="content-card-header"><h5>申请提现</h5></div>
            <div class="content-card-body">
                @if (!Model.CanApply)
                {
                    <div class="alert alert-warning mb-0 d-flex gap-2 align-items-start">
                        <span>⚠</span>
                        <span>@Model.BlockReason</span>
                    </div>
                }
                else
                {
                    <form asp-action="Withdrawals" method="post" id="withdrawApplyForm">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between">
                                <span>提现金额（元）</span>
                                <span class="text-muted small">最多 ¥@Model.CurrentBalance.ToString("N2")</span>
                            </label>
                            <input asp-for="Form.ApplyAmount" id="applyAmount" type="number"
                                   step="0.01" min="0.01" max="@Model.CurrentBalance"
                                   class="form-control form-control-lg" placeholder="请输入提现金额" required />
                            <div class="quick-amounts mt-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary quick-amt" data-amt="@Model.CurrentBalance">全部</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary quick-amt" data-amt="500">500</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary quick-amt" data-amt="1000">1000</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary quick-amt" data-amt="2000">2000</button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">收款平台</label>
                            <select asp-for="Form.AccountPlatform" class="form-select" id="accountPlatform" required>
                                @foreach (var item in Model.PayAccounts)
                                {
                                    <option value="@item.Platform">@item.Label@(item.IsBound ? "" : "（未绑定）")</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">收款账户信息</label>
                            <input asp-for="Form.AccountInfo" class="form-control" id="accountInfo"
                                   placeholder="请先绑定收款账户" readonly required />
                            <div class="form-text text-danger d-none" id="accountBindHint">请先绑定该收款账户后再提交提现。</div>
                        </div>
                        <button type="submit" class="btn btn-success w-100 btn-lg" id="submitWithdrawBtn">提交提现申请</button>
                    </form>
                }
            </div>
        </div>

        @{
            var withdrawBindModel = new PromoterPayAccountBindModel
            {
                ReturnAction = "Withdrawals",
                Accounts = Model.PayAccounts
            };
        }
        <partial name="_PayAccountBind" model="withdrawBindModel" />

        <div class="content-card">
            <div class="content-card-header"><h5>提现流程</h5></div>
            <div class="content-card-body">
                <div class="flow-steps">
                    <div class="flow-step"><span class="flow-num">1</span>提交申请，余额转入冻结</div>
                    <div class="flow-step"><span class="flow-num">2</span>平台审核（1~3 工作日）</div>
                    <div class="flow-step"><span class="flow-num">3</span>审核通过，转账至收款账户</div>
                    <div class="flow-step"><span class="flow-num">4</span>驳回则金额退回可提现余额</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="content-card">
            <div class="content-card-header">
                <h5>提现记录</h5>
                <span class="text-muted small">共 @Model.Records.Count 条</span>
            </div>
            <div class="content-card-body p-0">
                @if (!Model.Records.Any())
                {
                    <div class="empty-state">
                        <div class="empty-icon">💳</div>
                        <p>暂无提现记录</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>申请编号</th>
                                    <th>金额</th>
                                    <th>收款账户</th>
                                    <th>申请时间</th>
                                    <th>状态</th>
                                    <th>备注</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.Records)
                                {
                                    <tr>
                                        <td><code class="order-id">@r.WithdrawalId</code></td>
                                        <td class="fw-semibold">¥@r.ApplyAmount.ToString("N2")</td>
                                        <td class="small">@r.AccountInfo</td>
                                        <td class="small text-muted">@r.ApplyTime.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td><span class="badge bg-@r.AuditStatusBadgeClass">@r.AuditStatusLabel</span></td>
                                        <td class="small">
                                            @if (r.AuditStatus == "Rejected")
                                            {
                                                <span class="text-danger">@r.RejectReason</span>
                                            }
                                            else if (r.TransferTime.HasValue)
                                            {
                                                <span class="text-muted">转账 @r.TransferTime.Value.ToString("yyyy-MM-dd")</span>
                                            }
                                            else if (r.AuditStatus == "Pending")
                                            {
                                                <span class="text-warning">审核中…</span>
                                            }
                                            else
                                            {
                                                @:—
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.quick-amt').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var amt = parseFloat(btn.dataset.amt);
                var max = @Model.CurrentBalance.ToString(System.Globalization.CultureInfo.InvariantCulture);
                document.getElementById('applyAmount').value = Math.min(amt, max).toFixed(2);
            });
        });

        (function () {
            var bound = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.PayAccounts.ToDictionary(a => a.Platform, a => a.AccountNo ?? string.Empty)));
            var platformEl = document.getElementById('accountPlatform');
            var accountEl = document.getElementById('accountInfo');
            var hintEl = document.getElementById('accountBindHint');
            var submitBtn = document.getElementById('submitWithdrawBtn');
            var form = document.getElementById('withdrawApplyForm');
            if (!platformEl || !accountEl) return;

            function syncAccount() {
                var platform = platformEl.value;
                var account = (bound[platform] || '').trim();
                accountEl.value = account;
                var unbound = !account;
                hintEl.classList.toggle('d-none', !unbound);
                accountEl.classList.toggle('is-invalid', unbound);
                if (submitBtn) submitBtn.disabled = unbound;
            }

            platformEl.addEventListener('change', syncAccount);
            if (form) {
                form.addEventListener('submit', function (e) {
                    var account = (accountEl.value || '').trim();
                    var amount = parseFloat(document.getElementById('applyAmount').value);
                    if (!account) {
                        e.preventDefault();
                        syncAccount();
                        alert('收款账户不能为空，请先绑定微信 / 支付宝 / 银行卡。');
                        return;
                    }
                    if (!amount || amount <= 0) {
                        e.preventDefault();
                        alert('请输入有效的提现金额。');
                    }
                });
            }
            syncAccount();
        })();
    </script>
    <partial name="_PayAccountBindScripts" />
}
