@{
    ViewData["Title"] = "注册审核";
    var promoters = (ViewBag.PendingPromoters as List<GroupC_CrmPromoter>) ?? new List<GroupC_CrmPromoter>();
    var suppliers = (ViewBag.PendingSuppliers as List<FreshColdChain.Models.DTOs.SupplierDto>) ?? new List<FreshColdChain.Models.DTOs.SupplierDto>();
    var admins = (ViewBag.PendingAdmins as List<GroupC_SysUser>) ?? new List<GroupC_SysUser>();
}
<partial name="_Alerts" />

<div class="content-card">
    <div class="content-card-header">
        <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11 3 17M18 13l-3 3-3-3M3 5h18v14H3z"/><path d="M3 3v18"/></svg> 注册审核</h5>
        <span class="text-muted small">团长 / 供应商 / 管理员 入驻申请</span>
    </div>
    <div class="content-card-body p-0">
        <ul class="nav nav-tabs px-3 pt-2" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabReviewPromoters" type="button" role="tab">
                    待审核团长 <span class="badge text-bg-primary ms-1">@promoters.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabReviewSuppliers" type="button" role="tab">
                    待审核供应商 <span class="badge text-bg-primary ms-1">@suppliers.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabReviewAdmins" type="button" role="tab">
                    待审核管理员 <span class="badge text-bg-primary ms-1">@admins.Count</span>
                </button>
            </li>
        </ul>
        <div class="tab-content p-0">
            <!-- 待审核团长 -->
            <div class="tab-pane fade show active" id="tabReviewPromoters" role="tabpanel">
                @if (!promoters.Any())
                {
                    <div class="empty-state">
                        <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.1 4.6 5 .6-3.7 3.4.9 5L12 14.6 7.7 16.6l.9-5L4.9 8.2l5-.6z"/></svg></div>
                        <p>暂无待审核的团长，一切正常！</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>团长编号</th>
                                    <th>团长名称</th>
                                    <th>登录账号</th>
                                    <th>联系方式</th>
                                    <th>注册时间</th>
                                    <th>操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in promoters)
                                {
                                    <tr>
                                        <td><code class="small">@item.PromoterId</code></td>
                                        <td><strong>@item.PromoterName</strong></td>
                                        <td>@item.LoginAccount</td>
                                        <td>@item.Phone</td>
                                        <td class="small text-muted">@item.RegisterTime.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>
                                            <form asp-action="ApprovePromoter" method="post" style="display:inline-block;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="promoterId" value="@item.PromoterId" />
                                                <button type="submit" class="btn btn-sm btn-success">✓ 通过</button>
                                            </form>
                                            <form asp-action="RejectPromoter" method="post" style="display:inline-block;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="promoterId" value="@item.PromoterId" />
                                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('确定要拒绝该团长注册吗？');">✗ 拒绝</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- 待审核供应商 -->
            <div class="tab-pane fade" id="tabReviewSuppliers" role="tabpanel">
                @if (!suppliers.Any())
                {
                    <div class="empty-state">
                        <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="m2 7 10 7L22 7"/></svg></div>
                        <p>暂无待审核的供应商入驻申请</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>供应商编号</th>
                                    <th>名称</th>
                                    <th>营业执照号</th>
                                    <th>资质到期日</th>
                                    <th>信用分</th>
                                    <th>联系电话</th>
                                    <th>登录账号</th>
                                    <th>操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in suppliers)
                                {
                                    <tr>
                                        <td><code class="small">@item.SupplierID</code></td>
                                        <td>@item.SupplierName</td>
                                        <td class="small">@item.LicenseNo</td>
                                        <td class="small text-muted">@item.ExpiryDate?.ToString("yyyy-MM-dd")</td>
                                        <td>@(item.CreditLevel > 0 ? item.CreditLevel.ToString() : "—")</td>
                                        <td class="small">@item.ContactPhone</td>
                                        <td class="small">@item.LoginAccount</td>
                                        <td>
                                            <div class="d-flex flex-wrap align-items-center gap-1">
                                                <form asp-action="ApproveSupplier" method="post" class="d-flex align-items-center gap-1"
                                                      onsubmit="return confirm('确认通过该供应商的入驻申请？');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="supplierId" value="@item.SupplierID" />
                                                    <input type="number" name="creditLevel" class="form-control form-control-sm"
                                                           style="width: 6rem;" min="0" max="100" placeholder="信用分" required />
                                                    <button type="submit" class="btn btn-sm btn-success">通过</button>
                                                </form>
                                                <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#supplierRejectModal-@item.SupplierID">
                                                    驳回
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- 待审核管理员 -->
            <div class="tab-pane fade" id="tabReviewAdmins" role="tabpanel">
                @if (!admins.Any())
                {
                    <div class="empty-state">
                        <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="m2 7 10 7L22 7"/></svg></div>
                        <p>暂无待审核的管理员注册申请</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>管理员</th>
                                    <th>所属种类</th>
                                    <th>登录账号</th>
                                    <th>联系电话</th>
                                    <th>注册时间</th>
                                    <th>操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in admins)
                                {
                                    <tr>
                                        <td>
                                            @item.RealName
                                            <div class="small text-muted"><code>@item.UserId</code></div>
                                        </td>
                                        <td><span class="badge text-bg-light border">@FreshColdChain.Filters.AdminSession.KindName(item.AdminKind)</span></td>
                                        <td class="small">@item.Username</td>
                                        <td class="small">@item.Phone</td>
                                        <td class="small text-muted">@item.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>
                                            <form asp-action="ApproveAdmin" method="post" style="display:inline-block;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@item.UserId" />
                                                <button type="submit" class="btn btn-sm btn-success">✓ 通过</button>
                                            </form>
                                            <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal"
                                                    data-bs-target="#adminRejectModal"
                                                    data-id="@item.UserId" data-name="@item.RealName">✗ 驳回</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- 供应商驳回模态框（每个供应商一个） -->
@foreach (var item in suppliers)
{
    <div class="modal fade" id="supplierRejectModal-@item.SupplierID" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">驳回入驻申请 - @item.SupplierName</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="RejectSupplier" method="post">
                    <div class="modal-body">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="supplierId" value="@item.SupplierID" />
                        <div class="mb-3">
                            <label class="form-label">驳回原因</label>
                            <textarea name="rejectReason" class="form-control" rows="3" placeholder="请填写驳回原因..." required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                        <button type="submit" class="btn btn-danger">确认驳回</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- 管理员驳回模态框（共享） -->
<div class="modal fade" id="adminRejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">驳回管理员注册申请</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="RejectAdmin" method="post">
                <div class="modal-body">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="adminRejectUserId" name="userId" />
                    <p class="text-muted small mb-2">管理员：<strong id="adminRejectUserName"></strong>（驳回后该账号将无法登录）</p>
                    <div class="mb-1">
                        <label class="form-label">驳回原因（可选）</label>
                        <textarea name="rejectReason" class="form-control" rows="3" placeholder="可填写驳回原因..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-danger">确认驳回</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    (function () {
        var modalEl = document.getElementById('adminRejectModal');
        if (modalEl) {
            modalEl.addEventListener('show.bs.modal', function (event) {
                var btn = event.relatedTarget;
                if (!btn) return;
                document.getElementById('adminRejectUserId').value = btn.getAttribute('data-id');
                document.getElementById('adminRejectUserName').textContent = btn.getAttribute('data-name');
            });
        }
    })();
</script>
