@model FreshColdChain.Models.DTOs.GroupC_PromoterAddInfo
@{
    ViewData["Title"] = "新增团长";
}
<partial name="_Alerts" />

<div class="content-card" style="max-width: 640px;">
    <div class="content-card-header">
        <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/><path d="M19 5v6M16 8h6"/></svg> 新增团长</h5>
        <span class="text-muted small">管理员创建的账号免审核，直接生效</span>
    </div>
    <div class="content-card-body">
        <form asp-action="AddPromoter" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">团长姓名 <span class="text-danger">*</span></label>
                <input type="text" class="form-control" name="PromoterName" value="@Model.PromoterName" required />
            </div>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label">登录账号 <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" name="LoginAccount" value="@Model.LoginAccount" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">登录密码 <span class="text-danger">*</span></label>
                    <input type="password" class="form-control" name="LoginPassword" required />
                </div>
            </div>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label">联系电话</label>
                    <input type="text" class="form-control" name="Phone" value="@Model.Phone" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">基础佣金率（小数，如 0.03 表示 3%）</label>
                    <input type="number" class="form-control" name="BaseCommissionRate"
                           value="@Model.BaseCommissionRate" step="0.001" min="0" max="1" />
                </div>
            </div>
            <button type="submit" class="btn btn-primary">创建团长</button>
            <a asp-action="ManagePromoters" class="btn btn-outline-secondary ms-2">返回列表</a>
        </form>
    </div>
</div>
