@model List<FinRefund>
@{
    ViewData["Title"] = "退款审核";
    var totalPending = Model.Count;
    var totalAmount = Model.Sum(x => x.RefundAmount);
}
<partial name="_Alerts" />

<!-- 汇总卡片 -->
<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-card-top">
            <span class="stat-icon bg-warning-subtle text-warning"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
            <span class="stat-label">待审核退款</span>
        </div>
        <div class="stat-value text-warning">@totalPending 笔</div>
        <div class="stat-sub">需平台审核</div>
    </div>
    <div class="stat-card sales">
        <div class="stat-card-top">
            <span class="stat-icon bg-purple-subtle text-purple"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 12h.01M18 12h.01"/></svg></span>
            <span class="stat-label">待审核总金额</span>
        </div>
        <div class="stat-value text-dark">@totalAmount.ToString("N2")</div>
        <div class="stat-sub">通过后执行资金回滚</div>
    </div>
</div>

<div class="content-card">
    <div class="content-card-header">
        <h5><svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/><path d="M14 3v5h5"/><path d="M9 12h6M9 16h6"/></svg> 退款申请列表</h5>
        <span class="text-muted small">通过后立即执行佣金/积分回滚，驳回需填写原因</span>
    </div>
    <div class="content-card-body p-0">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="m2 7 10 7L22 7"/></svg></div>
                <p>暂无待审核的退款申请</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>申请编号</th>
                            <th>订单编号</th>
                            <th>类型</th>
                            <th>退款金额</th>
                            <th>退款数量</th>
                            <th>申请时间</th>
                            <th>退款原因</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><code class="small">@item.RefundId</code></td>
                                <td><code class="small">@item.OrderId</code></td>
                                <td>
                                    @(string.IsNullOrEmpty(item.DetailId) ? "整单退款" : "部分退款")
                                    @if (!string.IsNullOrEmpty(item.SupplierId))
                                    {
                                        <div class="small text-muted">供应商 #@item.SupplierId</div>
                                    }
                                </td>
                                <td><strong class="text-danger">¥@item.RefundAmount.ToString("N2")</strong></td>
                                <td>@(item.RefundQty > 0 ? item.RefundQty.ToString() : "-")</td>
                                <td class="small text-muted">@item.ApplyTime.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="small">@item.Remark</td>
                                <td>
                                    <form asp-action="ApproveRefund" method="post" style="display:inline-block;"
                                          onsubmit="return confirm('确认通过该退款申请？通过后将立即执行佣金/积分回滚。');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="refundId" value="@item.RefundId" />
                                        <button type="submit" class="btn btn-sm btn-success">通过</button>
                                    </form>
                                    <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal-@item.RefundId">
                                        驳回
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- 每个申请一个专属驳回模态框 -->
@foreach (var item in Model)
{
    <div class="modal fade" id="rejectModal-@item.RefundId" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">驳回退款申请</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="RejectRefund" method="post">
                    <div class="modal-body">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="refundId" value="@item.RefundId" />
                        <div class="mb-3">
                            <label class="form-label">驳回原因</label>
                            <textarea name="rejectReason" class="form-control" rows="3" placeholder="请填写驳回原因，将追加到申请备注中..." required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                        <button type="submit" class="btn btn-danger">确认驳回</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
