@model ErrorViewModel
@{
    ViewData["Title"] = "出错啦";
}

<div class="text-center my-5">
    <h1 class="text-danger">⚠️ 出错了</h1>
    <p class="text-muted">处理请求时发生了错误，请稍后重试。</p>

    @if (Model.ShowRequestId)
    {
        <p>
            <strong>请求ID：</strong> <code>@Model.RequestId</code>
        </p>
    }
</div>
