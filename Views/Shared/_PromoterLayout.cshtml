@inject FreshColdChain.Services.PromoterPortalDataProvider PromoterData
@using FreshColdChain.Services

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>鲜邻团·生鲜冷链直销系统工作台</title>
    <link rel="icon" type="image/png" href="~/images/favicon.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/promoter-portal.css" asp-append-version="true" />
</head>
<body class="promoter-portal portal-shell role-promoter">
    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        var promoterId = Context.Session.GetString("PromoterId");
        var promoterName = Context.Session.GetString("PromoterName") ?? "团长";
        var promoterAvatar = string.Empty;
        var levelName = "普通团长";
        var baseCommissionRate = 0m;
        var totalSales = 0m;
        if (!string.IsNullOrEmpty(promoterId))
        {
            var promoter = PromoterData.GetPromoter(promoterId);
            promoterAvatar = promoter.Avatar ?? string.Empty;
            levelName = PromoterPortalDataProvider.ResolveLevelName(promoter.TotalSales);
            baseCommissionRate = PromoterPortalDataProvider.ResolveCommissionRatePercent(promoter.BaseCommissionRate);
            totalSales = promoter.TotalSales;
        }
    }
    <div class="portal-wrapper">
        <aside class="portal-sidebar">
            <div class="sidebar-brand">
                @if (!string.IsNullOrWhiteSpace(promoterAvatar))
                {
                    <img class="brand-avatar" src="@Url.Content("~/images/avatars/" + promoterAvatar + ".png")" alt="@promoterName 头像" />
                }
                else
                {
                    <span class="brand-icon">@promoterName.FirstOrDefault('团')</span>
                }
                <div class="brand-info">
                    <div class="brand-title-row">
                        <span class="brand-title">@promoterName</span>
                        <span class="level-badge">@levelName</span>
                    </div>
                    <div class="brand-metrics">
                        <div class="metric-row">
                            <span class="metric-label">基础佣金</span>
                            <span class="metric-value">@baseCommissionRate.ToString("0.##")%</span>
                        </div>
                        <div class="metric-row">
                            <span class="metric-label">累计销售额</span>
                            <span class="metric-value">¥@totalSales.ToString("N2")</span>
                        </div>
                    </div>
                </div>
            </div>
            <nav class="sidebar-nav">
                <a asp-controller="Promoters" asp-action="Dashboard"
                   class="nav-link @(currentAction == "Dashboard" ? "active" : "")">
                    <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5 12 3l9 6.5"/><path d="M5 10v9a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1v-9"/></svg></span> 工作台
                </a>
                <a asp-controller="Promoters" asp-action="Performance"
                   class="nav-link @(currentAction == "Performance" ? "active" : "")">
                    <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="M7 14l3-4 4 3 5-7"/></svg></span> 业绩概览
                </a>
                <a asp-controller="Promoters" asp-action="Commissions"
                   class="nav-link @(currentAction == "Commissions" ? "active" : "")">
                    <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 12h.01M18 12h.01"/></svg></span> 佣金明细
                </a>
                <a asp-controller="Promoters" asp-action="Withdrawals"
                   class="nav-link @(currentAction == "Withdrawals" ? "active" : "")">
                    <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/><path d="M9 15h6"/></svg></span> 提现管理
                </a>
                <a asp-controller="Promoters" asp-action="Profile"
                   class="nav-link @(currentAction == "Profile" ? "active" : "")">
                    <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg></span> 个人资料
                </a>
                <a asp-controller="Promoters" asp-action="ProductListing"
                   class="nav-link @(currentAction is "ProductListing" or "EntryDetail" ? "active" : "")">
                    <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg></span> 商品上架
                </a>
                <a asp-controller="Promoters" asp-action="BoundConsumers"
                   class="nav-link @(currentAction == "BoundConsumers" ? "active" : "")">
                    <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.5 3-5.5 6.5-5.5s6.5 2 6.5 5.5"/><circle cx="17" cy="9" r="2.5"/><path d="M17 14.5c2.5.3 4.5 2 4.5 5"/></svg></span> 我的消费者
                </a>
            </nav>
            <div class="sidebar-footer">
                @await Component.InvokeAsync("PromoterSidebar")
            </div>
        </aside>
        <main class="portal-main">
            <header class="portal-header d-flex align-items-center justify-content-between">
                <div class="portal-header-left">
                    <span class="portal-brand" aria-label="鲜邻团">
                        <span class="pb-word">鲜邻团<i class="pb-smile" aria-hidden="true"></i></span>
                        <small>fresh</small>
                    </span>
                    <span class="portal-header-sep" aria-hidden="true"></span>
                    <h1 class="page-title mb-0">@ViewData["Title"]</h1>
                </div>
                <div class="portal-header-right">
                    <span class="portal-header-sep" aria-hidden="true"></span>
                    <div id="clock" class="portal-clock" title="当前时间">
                        <span>
                            <small id="clock-date"></small>
                            <strong id="clock-time"></strong>
                        </span>
                    </div>
                </div>
            </header>
            <div class="portal-content">
                @RenderBody()
            </div>
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        (function () {
            function updateClock() {
                var elDate = document.getElementById('clock-date');
                var elTime = document.getElementById('clock-time');
                if (!elDate || !elTime) {
                    return;
                }
                var now = new Date();
                var weekdays = ['日', '一', '二', '三', '四', '五', '六'];
                var year = now.getFullYear();
                var month = String(now.getMonth() + 1).padStart(2, '0');
                var day = String(now.getDate()).padStart(2, '0');
                var hours = String(now.getHours()).padStart(2, '0');
                var minutes = String(now.getMinutes()).padStart(2, '0');
                var seconds = String(now.getSeconds()).padStart(2, '0');
                elDate.textContent = '星期' + weekdays[now.getDay()] + ' ' + year + '年' + month + '月' + day + '日';
                elTime.textContent = hours + ':' + minutes + ':' + seconds;
            }
            updateClock();
            setInterval(updateClock, 1000);
        })();
    </script>
</body>
</html>
