@model CouponCenterViewModel
@{
    ViewData["Title"] = "优惠券中心";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h3 mb-2">优惠券中心</h1>
            <p class="text-muted mb-0">@Model.CustomerName（#@Model.CustomerId）· 每种券每人限领一张</p>
        </div>
        <a asp-controller="Customer" asp-action="Index" asp-route-id="@Model.CustomerId"
           class="btn btn-outline-secondary align-self-md-start">返回消费者中心</a>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <section class="mb-5">
        <h2 class="h4 mb-3">可领取</h2>
        @if (Model.ClaimableCoupons.Count == 0)
        {
            <div class="alert alert-light border">当前没有进行中的优惠券活动。</div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var coupon in Model.ClaimableCoupons)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body p-4 d-flex flex-column">
                                <div class="text-primary fw-semibold mb-2">@coupon.CouponName</div>
                                <div class="display-6 fw-bold mb-2">
                                    <span class="fs-5">¥</span>@coupon.DiscountAmount.ToString("F0")
                                </div>
                                <div class="text-muted small mb-1">
                                    满 ¥@coupon.MinOrderAmount.ToString("F2") 可用
                                </div>
                                <div class="text-muted small mb-3">
                                    有效至 @coupon.EndTime.ToString("yyyy-MM-dd HH:mm")
                                </div>
                                <div class="mt-auto d-flex justify-content-between align-items-center gap-2">
                                    <span class="small text-muted">剩余 @coupon.RemainingQuantity 张</span>
                                    @if (coupon.HasClaimed == 1)
                                    {
                                        <button type="button" class="btn btn-secondary btn-sm" disabled>
                                            已领取
                                        </button>
                                    }
                                    else if (coupon.RemainingQuantity <= 0)
                                    {
                                        <button type="button" class="btn btn-secondary btn-sm" disabled>
                                            已领完
                                        </button>
                                    }
                                    else
                                    {
                                        <form asp-action="Claim" method="post">
                                            <input type="hidden" name="customerId" value="@Model.CustomerId" />
                                            <input type="hidden" name="couponId" value="@coupon.CouponId" />
                                            <button type="submit" class="btn btn-primary btn-sm">立即领取</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <section>
        <h2 class="h4 mb-3">我的可用券</h2>
        @if (Model.AvailableCoupons.Count == 0)
        {
            <div class="alert alert-light border">暂无可用优惠券。</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>券名称</th>
                            <th>优惠</th>
                            <th>门槛</th>
                            <th>有效期至</th>
                            <th>下单记录ID</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var coupon in Model.AvailableCoupons)
                        {
                            <tr>
                                <td>@coupon.CouponName</td>
                                <td>¥@coupon.DiscountAmount.ToString("F2")</td>
                                <td>满 ¥@coupon.MinOrderAmount.ToString("F2")</td>
                                <td>@coupon.EndTime.ToString("yyyy-MM-dd HH:mm")</td>
                                <td><code>@coupon.RecordId</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
